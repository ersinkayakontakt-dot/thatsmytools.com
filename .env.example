# Vorlage für lokale Zugangsdaten. NIEMALS echte Schlüssel hier eintragen –
# diese Datei ist versioniert. Die echten Werte gehören in .env.local,
# das über .gitignore ausgeschlossen ist.

# Pexels-Bild-API, kostenlos unter https://www.pexels.com/api/
# Wird nur von scripts/fetch-stock-images.mjs gebraucht, nicht vom Build.
PEXELS_API_KEY=

# Google Search Console (Phase 7). Pfad zu einer Dienstkonto-JSON-Datei
# ausserhalb des Repositories.
GOOGLE_APPLICATION_CREDENTIALS=

# IndexNow. Wird sonst aus public/<key>.txt gelesen.
INDEXNOW_KEY=
