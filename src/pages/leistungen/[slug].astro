---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Blocks from '../../components/Blocks.astro';
import Faq from '../../components/Faq.astro';
import PriceFactors from '../../components/PriceFactors.astro';
import CtaBand from '../../components/CtaBand.astro';
import ContactCard from '../../components/ContactCard.astro';
import Icon from '../../components/Icon.astro';
import Todo from '../../components/Todo.astro';
import RelatedServiceLinks from '../../components/RelatedServiceLinks.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import RelevantLocations from '../../components/RelevantLocations.astro';
import CaseStudyLinks from '../../components/CaseStudyLinks.astro';
import NextStepPanel from '../../components/NextStepPanel.astro';
import ContextualCompanyLink from '../../components/ContextualCompanyLink.astro';
import Figure from '../../components/Figure.astro';
import { services } from '../../data/services';
import { seoPage } from '../../data/seo-pages';
import { heroImage, imagesForPage } from '../../data/images';
import { serviceIsIndexable, checkService } from '../../lib/publishGuard';
import { formatDate } from '../../lib/text';
import {
  buildGraph,
  organizationNode,
  websiteNode,
  webPageNode,
  breadcrumbNode,
  serviceNode,
  faqNode,
} from '../../lib/schema';

export function getStaticPaths() {
  // Auch Entwürfe werden gebaut, damit sie intern geprüft werden können.
  // Sie sind noindex und stehen nicht in der Sitemap.
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const path = `/leistungen/${service.slug}/`;
const indexable = serviceIsIndexable(service);
const guard = checkService(service);

const crumbs = [
  { name: 'Start', href: '/' },
  { name: 'Leistungen', href: '/leistungen/' },
  { name: service.navLabel, href: path },
];

const pageId = `service:${service.slug}`;
const seo = seoPage(pageId);

/**
 * Die Verweise unter dem Handlungsaufruf kommen aus `requiredOutboundLinks`
 * der Seitenkarte. Damit steht an einer Stelle, wohin eine Leistungsseite
 * führen muss – und der Linkgraph prüft, dass es auch passiert.
 *
 * Der Linktext ist die H1 der Zielseite. Er beschreibt damit von sich aus,
 * was dort steht, und kann nie zu „hier" oder „mehr" verkümmern.
 */
const nextStepLinks = seo.requiredOutboundLinks
  .filter((id) => id !== 'angebot-anfragen')
  .map((id) => {
    const target = seoPage(id);
    return { href: target.url, label: target.h1 };
  });

/**
 * Der Verweis auf den Betrieb steht nur dort, wo die Frage „wer macht das?"
 * wirklich aufkommt. Bei einer Kellerentrümpelung interessiert sie nicht.
 */
const COMPANY_LINK_ON: Record<string, 'nachlass' | 'senioren' | 'partner'> = {
  'nachlassaufloesung-berlin': 'nachlass',
  'seniorenumzug-berlin': 'senioren',
  'bueroaufloesung-berlin': 'partner',
  'messiwohnung-raeumen': 'nachlass',
};
const companyLinkContext = COMPANY_LINK_ON[service.slug];

/**
 * Das Hero-Bild ist das LCP-Bild dieser Seite: nicht lazy, mit Vorrang.
 * Genau eines je Seite – `npm run seo:images` bricht ab, wenn es mehr sind.
 * Seiten ohne Eintrag in der Bild-Registry bleiben schlicht ohne Bild.
 */
const hero = heroImage(pageId);
const inlineImages = imagesForPage(pageId).filter((img) => img.role === 'inline');


const schema = buildGraph([
  organizationNode(),
  websiteNode(),
  breadcrumbNode(path, crumbs),
  webPageNode({
    url: path,
    name: service.metaTitle,
    description: service.metaDescription,
    dateModified: service.updated,
    breadcrumbId: `https://schnellhelfer24.de${path}#breadcrumb`,
  }),
  serviceNode({
    url: path,
    name: service.h1,
    serviceType: service.serviceType,
    description: service.answer,
  }),
  faqNode(path, service.faq),
]);
---

<Base
  title={service.metaTitle}
  description={service.metaDescription}
  path={path}
  index={indexable}
  schema={schema}
  modified={service.updated}
>
  <Breadcrumbs items={crumbs} />

  {
    !indexable && (
      <div class="wrap">
        <div class="draft-banner" role="note">
          <strong>Entwurf.</strong> Diese Seite ist nicht veröffentlicht (noindex, nicht in der
          Sitemap, nicht verlinkt). Offen: {guard.missing.join('; ') || 'Freigabe'}.
        </div>
      </div>
    )
  }

  <div class="wrap section--tight">
    <div class="grid grid--sidebar">
      <article class="prose">
        <h1>{service.h1}</h1>

        <div class="answer">
          <p>{service.answer}</p>
        </div>

        {hero && <Figure image={hero} layout="hero" priority />}

        <!-- Situationen, die zu dieser Leistung führen -->
        <section class="sit-box">
          <h2 class="sit-box__head">Wann diese Leistung passt</h2>
          <ul>
            {service.situations.map((s) => <li>{s}</li>)}
          </ul>
        </section>

        <!-- Enthalten / nicht enthalten -->
        <section>
          <h2>Was enthalten ist</h2>
          <ul class="incl">
            {
              service.includes.map((i) => (
                <li>
                  <Icon name="check" size={17} />
                  <span>{i}</span>
                </li>
              ))
            }
          </ul>

          {
            service.notIncluded && service.notIncluded.length > 0 && (
              <>
                <h3>Was nicht enthalten ist</h3>
                <p class="text-muted">
                  Damit es keine Missverständnisse gibt, hier ausdrücklich das, was nicht dazugehört:
                </p>
                <ul class="excl">
                  {service.notIncluded.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              </>
            )
          }
        </section>

        <Blocks blocks={service.blocks} />

        <PriceFactors factors={service.priceFactors} id={`pf-${service.slug}`} />

        {inlineImages.map((img) => <Figure image={img} layout="wide" />)}

        <CaseStudyLinks serviceSlug={service.slug} variant="wide" />

        <Faq items={service.faq} id={`faq-${service.slug}`} />

        {companyLinkContext && <ContextualCompanyLink context={companyLinkContext} />}

        <NextStepPanel pageId={pageId} links={nextStepLinks} />

        <p class="updated">
          Zuletzt aktualisiert am {formatDate(service.updated)}. Verantwortlich für den Inhalt:
          Schnellhelfer24.
        </p>
      </article>

      <div class="sidebar">
        <ContactCard location={`leistung-${service.slug}`} />

        <RelatedGuides slugs={service.guides} />

        <RelatedServiceLinks slugs={service.related} current={service.slug} />

        <RelevantLocations
          intro="Wo wir am häufigsten im Einsatz sind. Was Altbau, Hinterhof und Parksituation für den Aufwand bedeuten, steht auf der jeweiligen Seite."
        />

        <Todo>
          Für diese Leistungsseite fehlen noch echte Einsatzfotos und mindestens ein
          veröffentlichter Einsatzbericht aus einem abgeschlossenen Auftrag.
        </Todo>
      </div>
    </div>
  </div>

  <CtaBand location={`leistung-${service.slug}`} pageId={pageId} />
</Base>

<style>
  .draft-banner {
    background: var(--warn-tint);
    border: 2px dashed var(--warn);
    color: var(--warn);
    padding: var(--sp-3) var(--sp-4);
    margin-top: var(--sp-4);
    font-size: 0.92rem;
  }

  .sit-box {
    background: var(--paper-2);
    border-left: 6px solid var(--ink);
    padding: var(--sp-4) var(--sp-5);
    margin: var(--sp-6) 0;
  }
  .sit-box__head {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 var(--sp-3);
  }
  .sit-box ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .sit-box li:last-child {
    margin-bottom: 0;
  }

  .incl {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0;
  }
  .incl li {
    display: flex;
    gap: var(--sp-3);
    align-items: flex-start;
    margin-bottom: var(--sp-2);
  }
  .incl :global(svg) {
    color: var(--ok);
    flex: none;
    margin-top: 0.25rem;
  }

  .excl {
    color: var(--ink-2);
  }
  .excl li::marker {
    color: var(--line-contrast);
  }


  .sidebar {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }

</style>
