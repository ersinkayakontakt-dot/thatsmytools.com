---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { phone, whatsapp, email } from '../lib/contact';
import { publishedGuides } from '../data/guides';
import { seoPage } from '../data/seo-pages';
import { handoverItems, openQuestions } from '../data/requestSignals';

/* Für das Inline-Skript: Schlüssel => Beschriftung und Zuständigkeit. */
const handoverMap = Object.fromEntries(handoverItems.map((i) => [i.key, { label: i.label, r: i.responsibility }]));
const openMap = Object.fromEntries(openQuestions.map((q) => [q.key, q.label]));

/* Metadaten kommen aus der zentralen Seitenkarte, damit Title,
   Description, URL und Sitemap-Datum nur an einer Stelle stehen. */
const page = seoPage('anfrage-erhalten');
const { url: path, title, metaDescription: description } = page;

/**
 * Bestätigungsseite.
 * noindex: Sie hat keinen Suchwert und soll nicht in Suchergebnissen
 * auftauchen. Nur eine Weiterleitung mit Referenz löst das Empfangsereignis aus.
 */

const prep = [
  'Was soll genau erledigt werden – und was ausdrücklich nicht?',
  'Gibt es Fotos, Maße oder Modellbezeichnungen, die das Vorhaben verständlicher machen?',
  'Wie sind Zugang, Etage und Parkmöglichkeiten vor Ort?',
  'Gibt es einen festen Wunsch- oder Übergabetermin?',
  'Soll Material mitgebracht, etwas vorbereitet oder Altes entsorgt werden?',
];
---

<Base title={title} description={description} path={path} index={false} hideStickyBar>
  <div class="wrap wrap--mid section">
    <div class="done">
      <span class="done__icon" data-receipt-icon hidden aria-hidden="true"><Icon name="check" size={30} /></span>
      <h1 data-receipt-title>Ihre Anfrage bei Schnellhelfer24</h1>
      <p class="lede" data-receipt-message>Nach einer erfolgreich übermittelten Anfrage finden Sie hier die nächsten Schritte. Ein Auftrag oder Termin wird erst gesondert bestätigt.</p>
      <p class="receipt-reference" data-receipt-reference hidden></p>
      <p data-receipt-photos hidden></p>
      <p data-mail-warning hidden></p>
      <a class="btn btn--primary" data-receipt-start href="/angebot-anfragen/">Vorhaben anfragen</a>
      <noscript><p>Wenn Sie direkt nach dem Absenden hierhin weitergeleitet wurden, wurde Ihre Anfrage auf dem Server angenommen. Preis und Termin sind damit noch nicht bestätigt.</p></noscript>
    </div>

    <!-- Zusammenfassung aus den abgesendeten Angaben. Wird clientseitig
         gefüllt, weil die Seite statisch ausgeliefert wird. Die Angaben
         stammen ausschließlich aus dem eigenen Browser des Nutzers. -->
    <section class="recap" data-recap hidden aria-labelledby="recap-head">
      <h2 id="recap-head">Ihre Angaben im Überblick</h2>
      <p>Zusammenfassung aus diesem Browser.</p>
      <dl data-recap-list></dl>
    </section>

    <!-- Übergabe-Einstieg (GROW-2026-02): Ablauf aus den eigenen Angaben,
         ohne Termin- oder Preiszusage. Wird nur clientseitig gefüllt. -->
    <section class="handover-plan" data-handover-plan hidden aria-labelledby="plan-head">
      <h2 id="plan-head">Ihr Ablauf bis zur Übergabe</h2>
      <p data-plan-date></p>
      <ol class="plan-steps" data-plan-steps></ol>
      <div data-plan-not hidden>
        <h3>Was wir nicht übernehmen</h3>
        <ul data-plan-not-list></ul>
        <p class="text-muted">Das sagen wir Ihnen im ersten Gespräch ausdrücklich, damit Sie es rechtzeitig anderweitig beauftragen können.</p>
      </div>
      <p class="text-muted">Die Reihenfolge ist die übliche Planung. Konkrete Termine, Umfang und Preis legen wir erst gemeinsam fest.</p>
    </section>

    <section class="open-first" data-open-first hidden aria-labelledby="open-head">
      <h2 id="open-head">Darauf gehen wir zuerst ein</h2>
      <ul data-open-list></ul>
    </section>

    <section aria-labelledby="next">
      <h2 id="next">Wie es weitergeht</h2>
      <ol class="steps">
        <li>
          <span class="steps__title">Wir sehen uns die Angaben an</span>
          <p>
            Jemand aus dem Team schaut sich Ihre Fotos und die Angaben zu Etage, Aufzug und Zugang
            an. Das macht kein Programm, sondern eine Person, die die Einsätze kennt.
          </p>
        </li>
        <li>
          <span class="steps__title">Wir melden uns zurück</span>
          <p>
            Auf dem Weg, den Sie angegeben haben. Wenn etwas unklar ist, fragen wir nach, statt zu
            raten. Häufig genügen ein oder zwei zusätzliche Fotos.
          </p>
        </li>
        <li>
          <span class="steps__title">Einschätzung oder Besichtigung</span>
          <p>
            Wir klären, ob Ihre Angaben und Fotos für eine Einschätzung ausreichen. Falls ein Termin
            vor Ort nötig ist, stimmen wir den Ablauf und die Bedingungen vorher mit Ihnen ab.
          </p>
        </li>
        <li>
          <span class="steps__title">Schriftliche Absprache</span>
          <p>
            Vor dem Einsatz steht fest, was enthalten ist, wie lange es dauert und was es kostet.
            Erst danach entscheiden Sie, ob Sie beauftragen.
          </p>
        </li>
      </ol>
    </section>

    <section class="urgent" aria-labelledby="eilig">
      <h2 id="eilig">Wenn es eilig ist</h2>
      <p>
        Wenn ein Übergabetermin drückt oder sich etwas geändert hat, warten Sie nicht auf unsere
        Rückmeldung, sondern melden Sie sich direkt.
      </p>
      <div class="btn-row">
        {
          phone.available && (
            <a class="btn btn--primary" href={phone.href} data-track="phone_click" data-track-location="bestaetigung">
              <Icon name="phone" size={19} />
              {phone.display}
            </a>
          )
        }
        {
          whatsapp.available && (
            <a
              class="btn btn--secondary"
              href={whatsapp.href}
              target="_blank"
              rel="noopener"
              data-track="whatsapp_click"
              data-track-location="bestaetigung"
            >
              <Icon name="whatsapp" size={19} />
              Weitere Fotos per WhatsApp
            </a>
          )
        }
        {
          email.available && (
            <a class="btn btn--ghost" href={email.href}>
              <Icon name="mail" size={19} />
              {email.address}
            </a>
          )
        }
        {!phone.available && !whatsapp.available && <a class="btn btn--primary" href="/kontakt/">Zur Kontaktseite</a>}
      </div>
      {
        whatsapp.available && (
          <p class="text-muted">
            Über WhatsApp können Sie Fotos direkt aus der Galerie schicken. Das ist der einfachste
            Weg, wenn Sie noch Räume nachreichen möchten.
          </p>
        )
      }
    </section>

    <section aria-labelledby="vorbereiten">
      <h2 id="vorbereiten">Das hilft uns bei der Einschätzung</h2>
      <p>
        Sie müssen nichts davon vorbereiten. Wenn Sie sich diese Punkte aber schon einmal ansehen,
        geht das Gespräch danach deutlich schneller:
      </p>
      <ul class="prep">
        {prep.map((p) => <li>{p}</li>)}
      </ul>
    </section>

    <section aria-labelledby="lesen">
      <h2 id="lesen">Bis dahin</h2>
      <ul class="links">
        {
          publishedGuides.slice(0, 5).map((g) => (
            <li>
              <a href={`/${g.hub}/${g.slug}/`}>{g.h1}</a>
              <span>{g.teaser}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .done {
    text-align: left;
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--sp-5);
    margin-bottom: var(--sp-6);
  }
  .done__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    background: var(--ok);
    color: var(--white);
    margin-bottom: var(--sp-4);
  }
  .done h1 {
    margin-bottom: var(--sp-3);
  }

  .recap {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-top: 1px solid var(--line);
    padding: var(--sp-5);
    margin-bottom: var(--sp-6);
  }
  .recap h2 {
    margin-top: 0;
    font-size: 1.05rem;
  }
  .recap dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem var(--sp-5);
    margin: 0;
    font-size: 0.95rem;
  }
  /* :global am Kind: Das Skript erzeugt diese Elemente zur Laufzeit ohne
     data-astro-cid-Attribut, scoped Regeln griffen deshalb nie. */
  .recap :global(dt) {
    color: var(--ink-3);
  }
  .recap :global(dd) {
    margin: 0;
    font-weight: 600;
  }

  .urgent {
    background: var(--paper-2);
    border-left: 6px solid var(--accent);
    padding: var(--sp-5);
    margin: var(--sp-6) 0;
  }
  .urgent h2 {
    margin-top: 0;
  }
  .urgent > :last-child {
    margin-bottom: 0;
  }

  .prep li {
    margin-bottom: var(--sp-2);
  }
  .prep li::marker {
    color: var(--accent);
  }

  .links {
    list-style: none;
    padding: 0;
  }
  .links li {
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .links a {
    display: block;
    font-weight: 700;
  }
  .links span {
    display: block;
    font-size: 0.9rem;
    color: var(--ink-3);
  }
.handover-plan{background:var(--paper-2);border-left:6px solid var(--accent);padding:var(--sp-5);margin-bottom:var(--sp-6);border-radius:var(--r-sm);}.handover-plan h2{margin-top:0;}.handover-plan h3{font-size:1rem;margin-top:var(--sp-4);}.plan-steps{padding-left:1.3rem;}.plan-steps :global(li){margin-bottom:var(--sp-2);}.plan-steps :global(strong){display:block;}.plan-steps :global(span){color:var(--ink-3);}.handover-plan[hidden],.open-first[hidden]{display:none;}.open-first{margin-bottom:var(--sp-6);}
.done__icon[hidden]{display:none;}.receipt-reference{padding:.8rem 1rem;border-radius:var(--r-sm);background:var(--brand-tint);display:inline-block;font-weight:700;}.receipt-reference[hidden]{display:none;}.done__icon{border-radius:50%;}.recap{border-radius:var(--r-lg);}
</style>

<script is:inline define:vars={{ handoverMap, openMap }}>
  (function () {
    var box = document.querySelector('[data-recap]');
    var list = document.querySelector('[data-recap-list]');
    if (!box || !list) return;

    // Reihenfolge der Zusammenfassung. Wer hier ein Feld ergänzt, muss es
    // auch im Formular (AufwandCheck.astro) und in der Auswertung
    // (public/api/anfrage.php) führen – sonst zeigt die Bestätigung etwas
    // an, was in der Anfrage nie ankommt.
    var labels = {
      leistung: 'Leistung',
      umfang: 'Umfang',
      anlass: 'Anlass',
      plz: 'Postleitzahl',
      // Das Formular legt hier bereits die Kurzfassung ab ("Regelmäßiges
      // Einsatzgebiet"), nicht den Schlüssel. Deshalb reicht die Beschriftung.
      gebiet: 'Einsatzgebiet',
      ort: 'Ort',
      objektart: 'Objekt',
      flaeche: 'Größe',
      fuellgrad: 'Füllgrad',
      etage: 'Etage',
      aufzug: 'Aufzug',
      zusatzleistungen: 'Zusatzleistungen',
      nebenraeume: 'Zusätzlich',
      zeitraum: 'Zeitraum',
      stichtag: 'Fester Termin',
      kontaktart: 'Antwort per',
    };

    var ref = new URLSearchParams(window.location.search).get('ref');
    if (!/^SH-\d{6}-[A-F0-9]{5}$/.test(ref || '')) return;
    document.querySelector('[data-receipt-title]').textContent = 'Danke. Ihre Anfrage ist eingegangen.';
    document.querySelector('[data-receipt-message]').textContent = 'Ihre Angaben sind auf dem Server gespeichert. Wir melden uns auf dem gewählten Kontaktweg und klären die nächsten Schritte. Ein Termin ist damit noch nicht bestätigt.';
    var reference = document.querySelector('[data-receipt-reference]');reference.textContent = 'Ihre Referenz: ' + ref;reference.hidden=false;
    document.querySelector('[data-receipt-icon]').hidden=false;
    document.querySelector('[data-receipt-start]').hidden=true;
    var photoMessage = document.querySelector('[data-receipt-photos]');
    var accepted = new URLSearchParams(window.location.search).get('fotos');
    if (/^\d{1,2}$/.test(accepted || '')) {photoMessage.textContent=accepted+' Fotos auf dem Server angenommen.';photoMessage.hidden=false;}
    if (new URLSearchParams(window.location.search).get('fotoHinweis') === '1') {photoMessage.textContent+=' Nicht alle Bilder konnten angenommen werden. Ihre Textanfrage ist gespeichert. Bitte reichen Sie fehlende Fotos über einen Kontaktweg nach und nennen Sie Ihre Referenz.';photoMessage.hidden=false;}
    if (new URLSearchParams(window.location.search).get('versand') === 'fehlgeschlagen') {
      var mailWarning=document.querySelector('[data-mail-warning]');mailWarning.textContent='Ihre Anfrage wurde gespeichert, aber die E-Mail-Benachrichtigung konnte nicht versendet werden. Bitte melden Sie sich zusätzlich telefonisch oder per WhatsApp und nennen Sie Ihre Referenz.';mailWarning.hidden=false;
    }
    try { localStorage.removeItem('sh24_check'); } catch (err) { /* lokaler Speicher kann gesperrt sein */ }
    try {
      var raw = sessionStorage.getItem('sh24_anfrage');
      if (!raw) return;
      var data = JSON.parse(raw);

      Object.keys(labels).forEach(function (key) {
        if (!data[key]) return;
        var dt = document.createElement('dt');
        dt.textContent = key === 'flaeche' && ['Malerarbeiten','Tapezieren'].includes(data.leistung) ? 'Wand-/Deckenfläche' : labels[key];
        var dd = document.createElement('dd');
        dd.textContent = data[key];
        list.appendChild(dt);
        list.appendChild(dd);
      });

      if (list.children.length) box.hidden = false;

      /* Übergabeplan aus den gewählten Anforderungen, in fester Reihenfolge. */
      if (data.vorhaben === 'uebergabe') {
        var chosen = Array.isArray(data.anforderungen) ? data.anforderungen.filter(function (k) { return handoverMap[k]; }) : [];
        var has = function (k) { return chosen.indexOf(k) >= 0; };
        var labelOf = function (k) { return handoverMap[k].label; };
        var steps = [['Erstgespräch und bei Bedarf Besichtigung', 'Wir gleichen Umfang und Anforderungen aus Vertrag oder Übergabeprotokoll ab' + (has('unklar') ? ' – bitte halten Sie das Dokument bereit.' : '.')]];
        var clear = ['geraeumt'].filter(has).map(labelOf);
        steps.push(['Räumung', clear.length ? clear.join(', ') : 'Was mitgenommen, verwertet oder entsorgt wird, legen wir vorher fest.']);
        var back = ['einbauten', 'boden-raus'].filter(has).map(labelOf);
        if (back.length) steps.push(['Rückbau', back.join(', ')]);
        var walls = ['duebel'].filter(has).map(labelOf).concat(['streichen', 'tapeten'].filter(has).map(function (k) { return labelOf(k) + ' (mit Fachbetrieb abgestimmt)'; }));
        if (walls.length) steps.push(['Wände', walls.join(', ')]);
        if (has('boden-neu')) steps.push(['Boden', labelOf('boden-neu')]);
        var finish = ['reinigung', 'besenrein'].filter(has).map(labelOf);
        steps.push(['Puffer und Übergabe', (finish.length ? finish.join(', ') + '. ' : '') + 'Zwischen Räumung und Übergabe planen wir Zeit für Nacharbeiten ein.']);
        var ol = document.querySelector('[data-plan-steps]');
        steps.forEach(function (st) {
          var li = document.createElement('li');
          var t = document.createElement('strong');
          t.textContent = st[0];
          var d = document.createElement('span');
          d.textContent = st[1];
          li.appendChild(t);
          li.appendChild(d);
          ol.appendChild(li);
        });
        var dateEl = document.querySelector('[data-plan-date]');
        var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(data.stichtag || '');
        dateEl.textContent = m ? 'Übergabetermin laut Ihrer Angabe: ' + m[3] + '.' + m[2] + '.' + m[1] + '. Wir planen rückwärts von diesem Tag.' : 'Den Übergabetermin klären wir im ersten Gespräch.';
        var not = chosen.filter(function (k) { return handoverMap[k].r === 'nicht'; });
        if (not.length) {
          var nl = document.querySelector('[data-plan-not-list]');
          not.forEach(function (k) { var li = document.createElement('li'); li.textContent = labelOf(k); nl.appendChild(li); });
          document.querySelector('[data-plan-not]').hidden = false;
        }
        document.querySelector('[data-handover-plan]').hidden = false;
      }
      if (Array.isArray(data.offen) && data.offen.length) {
        var ul = document.querySelector('[data-open-list]');
        data.offen.forEach(function (k) {
          if (!openMap[k]) return;
          var li = document.createElement('li');
          li.textContent = openMap[k];
          ul.appendChild(li);
        });
        if (ul.children.length) document.querySelector('[data-open-first]').hidden = false;
      }

      // Nur einmal anzeigen: beim erneuten Aufruf der Seite ist die
      // Zusammenfassung weg, damit keine Daten im Browser liegen bleiben.
      sessionStorage.removeItem('sh24_anfrage');

      if (window.sh24 && window.sh24.track) {
        window.sh24.track('lead_confirmed', { leistung: data.leistung || '' });
      }
    } catch (err) {
      /* ohne Zusammenfassung ist die Seite trotzdem vollständig */
    }
  })();
</script>
