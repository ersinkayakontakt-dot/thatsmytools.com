---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AufwandCheck from '../components/AufwandCheck.astro';
import Icon from '../components/Icon.astro';
import { phone, whatsapp } from '../lib/contact';
import { seoPage } from '../data/seo-pages';

/* Metadaten kommen aus der zentralen Seitenkarte, damit Title,
   Description, URL und Sitemap-Datum nur an einer Stelle stehen. */
const page = seoPage('angebot-anfragen');
const { url: path, title, metaDescription: description } = page;

import {
  buildGraph,
  organizationNode,
  websiteNode,
  webPageNode,
  breadcrumbNode,
} from '../lib/schema';

const crumbs = [
  { name: 'Start', href: '/' },
  { name: 'Einschätzung anfordern', href: path },
];

const schema = buildGraph([
  organizationNode(),
  websiteNode(),
  breadcrumbNode(path, crumbs),
  webPageNode({ url: path, name: title, description, dateModified: '2026-07-29' }),
]);
---

<Base title={title} description={description} path={path} schema={schema} hideStickyBar>
  <Breadcrumbs items={crumbs} />

  <div class="wrap section--tight">
    <div class="intro">
      <div>
        <p class="eyebrow">Ein guter Anfang</p>
        <h1>Erzählen Sie uns, was ansteht.</h1>
        <div class="answer">
          <p>
            Ein Möbelstück oder ein ganzes Objekt: Wir stellen Ihnen die passenden Fragen. Was noch offen ist, klären wir gemeinsam. Kostenlos, unverbindlich und ohne Registrierung.
          </p>
        </div>
      </div>

      <aside class="side">
        <p class="side__head">Lieber direkt sprechen?</p>
        <div class="side__ways">
          {
            phone.available && (
              <a class="btn btn--secondary btn--wide" href={phone.href} data-track="phone_click" data-track-location="formularseite">
                <Icon name="phone" size={18} />
                {phone.display}
              </a>
            )
          }
          {
            whatsapp.available && (
              <a
                class="btn btn--ghost btn--wide"
                href={whatsapp.href}
                target="_blank"
                rel="noopener"
                data-track="whatsapp_click"
                data-track-location="formularseite"
              >
                <Icon name="whatsapp" size={18} />
                Per WhatsApp schreiben
              </a>
            )
          }
          {
            !phone.available && (
              <a class="btn btn--secondary btn--wide" href="/kontakt/">
                <Icon name="mail" size={18} />
                Kontaktseite
              </a>
            )
          }
        </div>
        <p class="side__note">
          Am Telefon geht es schneller, wenn Sie Etage, Aufzug und den gewünschten Termin zur Hand
          haben.
        </p>
      </aside>
    </div>

    <div class="form-area">
      <AufwandCheck />

      <aside class="tips">
        <p class="eyebrow">Was passiert danach?</p>
        <h2 class="tips__head">Erst verstehen. Dann abstimmen.</h2>
        <ol class="request-next"><li><strong>Wir sehen uns Ihr Vorhaben an.</strong><span>Bei offenen Punkten fragen wir persönlich nach.</span></li><li><strong>Sie bekommen Klarheit zum Umfang.</strong><span>Arbeit, Material, Anfahrt und weitere Leistungen werden besprochen.</span></li><li><strong>Sie entscheiden über den Auftrag.</strong><span>Preis und Termin werden gesondert bestätigt.</span></li></ol>
        <p class="tips__link"><a href="/ratgeber/welche-fotos-fuer-ein-angebot/">Welche Fotos sind hilfreich? →</a></p>
        <h2 class="tips__head">Was mit Ihren Fotos passiert</h2>
        <p>
          Sie entscheiden, welche Fotos Sie schicken. Bitte persönliche Unterlagen und unnötige Personenaufnahmen weglassen. Details zu Verarbeitung und Löschung stehen in der <a href="/datenschutz/">Datenschutzerklärung</a>.
        </p>
      </aside>
    </div>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--sp-5);
    margin-bottom: var(--sp-6);
  }
  @media (min-width: 60em) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 18rem;
      gap: var(--sp-7);
      align-items: start;
    }
  }
  .intro h1 {
    margin-top: 0;
  }
  .intro .answer {
    margin-bottom: 0;
  }

  .side {
    border: 1px solid var(--line);
    border-top: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--paper-2);
    padding: var(--sp-4) var(--sp-5);
  }
  .side__head {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    font-weight: 700;
    margin: 0 0 var(--sp-3);
  }
  .side__ways {
    display: grid;
    gap: var(--sp-2);
  }
  .side__note {
    font-size: 0.87rem;
    color: var(--ink-3);
    margin: var(--sp-3) 0 0;
  }

  .form-area {
    display: grid;
    gap: var(--sp-6);
  }
  @media (min-width: 66em) {
    .form-area {
      grid-template-columns: minmax(0, 1fr) 18rem;
      gap: var(--sp-7);
      align-items: start;
    }
  }

  .tips {
    border-top: 1px solid var(--line);
    padding-top: var(--sp-4);
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  .tips__head {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 var(--sp-3);
  }
  .tips h2 + p,
  .tips h2 + ul {
    margin-top: 0;
  }
  .tips ul {
    padding-left: 1.1rem;
    margin-bottom: var(--sp-5);
  }
  .tips li {
    margin-bottom: var(--sp-3);
    line-height: 1.5;
  }
  .tips li::marker {
    color: var(--accent);
  }
  .tips strong {
    color: var(--ink);
  }
  .tips__link {
    margin-bottom: var(--sp-6);
  }
.intro .answer{border:0;padding:0;background:none;font-size:1.05rem;line-height:1.7;max-width:42rem;}.intro h1{font-size:clamp(2rem,4vw,3.3rem);letter-spacing:-.045em;line-height:1.12;max-width:15ch;}.tips{border-radius:var(--r-lg);background:var(--paper-2);border:1px solid var(--line);padding:1.5rem;align-self:start;}.request-next{list-style:none;padding:0;counter-reset:next;display:grid;gap:1.3rem;margin:1.5rem 0;}.request-next li{counter-increment:next;display:grid;grid-template-columns:1.7rem 1fr;gap:.2rem .65rem;font-size:.84rem;}.request-next li::before{content:counter(next);grid-row:1/3;width:1.6rem;height:1.6rem;border-radius:50%;background:var(--white);display:grid;place-items:center;font-size:.75rem;font-weight:700;}.request-next span{grid-column:2;color:var(--ink-2);line-height:1.55;}.tips__head{font-size:1.25rem;text-transform:none;letter-spacing:-.025em;}.tips p{font-size:.84rem;line-height:1.65;}.side{background:var(--white);}
</style>
