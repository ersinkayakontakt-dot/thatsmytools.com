---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { publishedServices } from '../data/services';
import { situations } from '../data/situations';
import { faqGroups } from '../data/faq';
import { buildGraph, organizationNode, websiteNode, webPageNode, faqNode } from '../lib/schema';
import { primaryCta } from '../lib/contact';

const title = 'Wohnungsauflösung & Seniorenumzug Berlin | Schnellhelfer24';
const description =
  'Komplette Wohnungsauflösungen, Nachlässe und Seniorenumzüge in Berlin und im Umland – von der Sichtung bis zur besenreinen Übergabe, persönlich koordiniert.';
const path = '/';

const homeFaq = [
  faqGroups[0].items[0],
  faqGroups[0].items[1],
  faqGroups[1].items[0],
  faqGroups[2].items[0],
];

const schema = buildGraph([
  organizationNode(),
  websiteNode(),
  webPageNode({
    url: path,
    name: title,
    description,
    dateModified: '2026-07-30',
  }),
  faqNode(path, homeFaq),
]);

/*
 * Reihenfolge der Startseite ist eine wirtschaftliche Entscheidung, keine
 * Datenreihenfolge: oben die Komplettaufträge, darunter die Leistungen, die
 * auch einzeln beauftragt werden. `serviceBySlug` bricht beim Build ab, wenn
 * ein Slug nicht mehr existiert – so fällt ein Umbenennen sofort auf, statt
 * still eine Kachel verschwinden zu lassen.
 */
const serviceBySlug = (slug: string) => {
  const found = publishedServices.find((s) => s.slug === slug);
  if (!found) throw new Error(`Startseite verweist auf unbekannte Leistung: ${slug}`);
  return found;
};

const completeJobs = [
  'wohnungsaufloesung-berlin',
  'nachlassaufloesung-berlin',
  'seniorenumzug-berlin',
  'haushaltsaufloesung-berlin',
  'bueroaufloesung-berlin',
  'umzug-berlin',
].map(serviceBySlug);

const singleJobs = [
  'entruempelung-berlin',
  'kellerentruempelung-berlin',
  'messiwohnung-raeumen',
  'sperrmuellabholung-berlin',
].map(serviceBySlug);
---

<Base title={title} description={description} path={path} schema={schema}>
  <Hero />

  <section class="cases" aria-labelledby="situationen">
    <div class="wrap">
      <div class="cases__head">
        <p class="eyebrow">Worum es meistens geht</p>
        <h2 id="situationen">Sie haben keine Leistung gesucht.<br />Sie haben eine Situation.</h2>
      </div>
      <ul class="cases__grid">
        {
          situations.map((s) => (
            <li>
              <a href={s.href}>
                <Icon name={s.icon} size={26} />
                <strong>{s.title}</strong>
                <small>{s.text}</small>
                <span class="cases__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="work" aria-labelledby="arbeit">
    <div class="wrap work__grid">
      <div class="work__intro">
        <p class="eyebrow">Komplett übernommen</p>
        <h2 id="arbeit">Ein Auftrag.<br />Eine Ansprechperson.</h2>
        <p>
          Sichtung, Sortierung, Räumung, Transport, Aufbau, Reinigung und Übergabe laufen über
          dieselbe Koordination – in Berlin und im Umland.
        </p>
        <a class="text-link" href="/leistungen/">Alle Leistungen ansehen <span aria-hidden="true">↗</span></a>
      </div>

      <ol class="service-list">
        {
          completeJobs.map((service, index) => (
            <li>
              <a href={`/leistungen/${service.slug}/`}>
                <span class="service-list__number">{String(index + 1).padStart(2, '0')}</span>
                <span>
                  <strong>{service.navLabel}</strong>
                  <small>{service.teaser}</small>
                </span>
                <span class="service-list__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="single" aria-labelledby="einzeln">
    <div class="wrap single__grid">
      <div>
        <p class="eyebrow">Auch einzeln möglich</p>
        <h2 id="einzeln">Kleiner Auftrag? Geht auch.</h2>
        <p>
          Ein Keller, ein Zimmer, einzelne Möbel. Wenn daraus später mehr wird, planen wir es in
          einem Termin statt in dreien.
        </p>
      </div>
      <ul class="single__list">
        {
          singleJobs.map((service) => (
            <li>
              <a href={`/leistungen/${service.slug}/`}>
                {service.navLabel}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="process" aria-labelledby="ablauf">
    <div class="wrap">
      <div class="process__head">
        <p class="eyebrow">Kein Preisraten am Telefon</p>
        <h2 id="ablauf">Erst ansehen.<br />Dann fest absprechen.</h2>
      </div>
      <ol class="process__steps">
        <li>
          <span>01</span>
          <h3>Zeigen</h3>
          <p>Fotos schicken oder einen kostenlosen Besichtigungstermin vereinbaren.</p>
        </li>
        <li>
          <span>02</span>
          <h3>Klären</h3>
          <p>Sie erfahren vorab, was gemacht wird, wie lange es dauert und was enthalten ist.</p>
        </li>
        <li>
          <span>03</span>
          <h3>Machen</h3>
          <p>Wir räumen, transportieren ab und übergeben wie vereinbart – auf Wunsch besenrein.</p>
        </li>
      </ol>
      <a class="btn btn--primary process__cta" href={primaryCta.href}>
        <Icon name="camera" size={19} />
        Auftrag kurz zeigen
      </a>
    </div>
  </section>

  <section class="straight" aria-labelledby="klartext">
    <div class="wrap straight__grid">
      <div>
        <p class="eyebrow">Klartext</p>
        <h2 id="klartext">Was Sie von uns nicht hören werden.</h2>
      </div>
      <div class="straight__copy">
        <p>
          Keine erfundenen Ab-Preise. Keine angeblichen Zertifikate. Keine „24/7“-Versprechen,
          wenn niemand ans Telefon geht.
        </p>
        <p>
          Wir schauen uns den Auftrag an, sagen ehrlich, was machbar ist, und halten die Absprache
          vor Beginn fest. Mehr braucht es meistens nicht.
        </p>
      </div>
    </div>
  </section>

  <section class="faq-home" aria-labelledby="faq-home">
    <div class="wrap faq-home__grid">
      <div>
        <p class="eyebrow">Kurz beantwortet</p>
        <h2>Fragen vor dem ersten Anruf</h2>
        <a class="text-link" href="/fragen/">Alle Fragen ansehen <span aria-hidden="true">↗</span></a>
      </div>
      <Faq items={homeFaq} title="Häufige Fragen" id="faq-home" openFirst />
    </div>
  </section>

  <CtaBand
    location="home-footer"
    headline="Was muss weg?"
    text="Schicken Sie ein paar Fotos, die Etage und Ihren Wunschtermin. Wir melden uns persönlich."
  />
</Base>

<style>
  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent-text);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Situationseinstiege: erste Sektion nach dem Hero. Kartenraster statt
     Liste, damit sich die sechs Einstiege optisch von der nummerierten
     Leistungsliste darunter unterscheiden. */
  .cases {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--line-strong);
  }
  .cases__head {
    max-width: 40rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .cases h2 {
    margin: 0;
    font-size: clamp(2rem, 4.2vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .cases__grid {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
  }
  .cases__grid li {
    margin: 0;
    background: var(--paper);
  }
  .cases__grid a {
    display: grid;
    gap: 0.7rem;
    height: 100%;
    padding: clamp(1.4rem, 2.5vw, 2rem);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .cases__grid a:hover {
    background: var(--white);
  }
  .cases__grid strong {
    font-size: 1.12rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
    /* Überschriften nicht automatisch trennen – "auf-gelöst" quer über zwei
       Zeilen liest sich schlechter als eine etwas kürzere erste Zeile. */
    hyphens: manual;
  }
  .cases__grid small {
    color: var(--ink-2);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .cases__arrow {
    color: var(--accent-text);
    font-weight: 800;
  }
  @media (min-width: 44em) {
    .cases__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 68em) {
    .cases__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Nebenleistungen: bewusst ruhiger und kleiner als die Komplettaufträge. */
  .single {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--paper);
    border-top: 1px solid var(--line-strong);
  }
  .single__grid {
    display: grid;
    gap: 2rem;
  }
  .single h2 {
    margin: 0 0 0.9rem;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .single__grid > div > p {
    max-width: 30rem;
    margin: 0;
    color: var(--ink-2);
  }
  .single__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .single__list li {
    margin: 0;
  }
  .single__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.95rem;
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
  }
  .single__list a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  @media (min-width: 60em) {
    .single__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(3rem, 6vw, 7rem);
      align-items: center;
    }
  }

  .work {
    padding-block: clamp(4rem, 8vw, 8rem);
    background: var(--paper);
  }
  .work__grid {
    display: grid;
    gap: 3rem;
  }
  .work__intro {
    align-self: start;
  }
  .work h2,
  .process h2,
  .straight h2,
  .faq-home h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.3rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }
  .work__intro > p:not(.eyebrow) {
    max-width: 28rem;
    color: var(--ink-2);
  }
  @media (min-width: 60em) {
    .work__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(4rem, 8vw, 9rem);
    }
    .work__intro {
      position: sticky;
      top: 2rem;
    }
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .service-list li {
    margin: 0;
    border-bottom: 1px solid var(--line-strong);
  }
  .service-list a {
    display: grid;
    grid-template-columns: 2.4rem 1fr 2rem;
    gap: 1rem;
    align-items: start;
    padding: 1.4rem 0;
    color: var(--ink);
    text-decoration: none;
  }
  .service-list a:hover strong {
    color: var(--accent-text);
  }
  .service-list__number {
    padding-top: 0.15rem;
    color: var(--ink-3);
    font: 700 0.75rem/1 var(--font-mono);
  }
  .service-list strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    line-height: 1.15;
  }
  .service-list small {
    display: block;
    max-width: 34rem;
    color: var(--ink-3);
    line-height: 1.45;
  }
  .service-list__arrow {
    color: var(--accent);
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.15s ease;
  }
  .service-list a:hover .service-list__arrow {
    transform: translateX(0.3rem);
  }

  .process {
    padding-block: clamp(4rem, 8vw, 8rem);
    background: var(--ink);
    color: var(--white);
  }
  .process h2,
  .process h3 {
    color: var(--white);
  }
  .process__head {
    max-width: 58rem;
  }
  .process__steps {
    display: grid;
    list-style: none;
    margin: clamp(3rem, 6vw, 5rem) 0 2.5rem;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
  }
  .process__steps li {
    margin: 0;
    padding: 1.5rem 0 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  }
  .process__steps span {
    color: var(--on-dark-accent);
    font: 700 0.78rem/1 var(--font-mono);
  }
  .process__steps h3 {
    margin: 1rem 0 0.5rem;
    font-size: 1.6rem;
  }
  .process__steps p {
    margin: 0;
    max-width: 24rem;
    color: var(--on-dark);
  }
  @media (min-width: 48em) {
    .process__steps {
      grid-template-columns: repeat(3, 1fr);
    }
    .process__steps li {
      padding: 1.75rem 2rem 2rem 0;
      border-bottom: 0;
    }
    .process__steps li + li {
      padding-left: 2rem;
      border-left: 1px solid rgba(255, 255, 255, 0.25);
    }
  }

  .straight {
    padding-block: clamp(4rem, 8vw, 8rem);
    background: var(--accent);
    color: var(--white);
  }
  .straight .eyebrow {
    color: var(--white);
  }
  .straight h2 {
    color: var(--white);
    max-width: 11ch;
  }
  .straight__grid {
    display: grid;
    gap: 2rem;
  }
  .straight__copy {
    max-width: 37rem;
    align-self: end;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.45;
  }
  .straight__copy p:last-child {
    margin-bottom: 0;
  }
  @media (min-width: 60em) {
    .straight__grid {
      grid-template-columns: 1fr 0.8fr;
      gap: 5rem;
    }
  }

  .faq-home {
    padding-block: clamp(4rem, 8vw, 8rem);
  }
  .faq-home__grid {
    display: grid;
    gap: 3rem;
  }
  .faq-home h2 {
    font-size: clamp(2rem, 4vw, 3.7rem);
  }
  @media (min-width: 60em) {
    .faq-home__grid {
      grid-template-columns: 0.75fr 1.25fr;
      gap: 6rem;
    }
  }

  .text-link {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    padding-block: 0.35rem;
    font-weight: 750;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
  }
</style>
