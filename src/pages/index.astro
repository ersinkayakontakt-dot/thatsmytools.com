---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Figure from '../components/Figure.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { heroImage } from '../data/images';
import { publishedServices } from '../data/services';
import { publishedCategories } from '../data/categories';
import { faqGroups } from '../data/faq';
import { site } from '../config/site';
import { whatsapp } from '../lib/contact';
import { seoPage } from '../data/seo-pages';
import { formatDate } from '../lib/text';
import { buildGraph, organizationNode, websiteNode, webPageNode, faqNode } from '../lib/schema';
const page = seoPage('home');
const homeFaq = [faqGroups[0].items[0],faqGroups[0].items[1],faqGroups[1].items[0],faqGroups[2].items[0]];
const schema = buildGraph([organizationNode(),websiteNode(),webPageNode({url:'/',name:page.title,description:page.metaDescription,dateModified:page.lastmod}),faqNode('/',homeFaq)]);
const paths = [
  {title:'Aufbauen. Ankommen.',text:'Neue Möbel, eine neue Küche oder ein Wohnungswechsel. Wir klären, was Sie brauchen.',image:'service:moebelmontage-berlin',label:'Montage & Umzug',slug:'moebelmontage-berlin',links:['moebelmontage-berlin','kuechenmontage-berlin','umzug-berlin']},
  {title:'Platz für neue Ideen.',text:'Räume verändern und Oberflächen erneuern. Mit klaren Zuständigkeiten für jedes Gewerk.',image:'service:trockenbau-berlin',label:'Innenausbau',slug:'innenausbau-berlin',links:['innenausbau-berlin','trockenbau-berlin','bodenbelag-verlegen-berlin','malerarbeiten-berlin','tapezieren-berlin','demontage-rueckbau']},
  {title:'Loslassen. Aufatmen.',text:'Einzelne Räume oder ein ganzer Haushalt: Wir besprechen, was bleiben soll und was gehen darf.',image:'service:entruempelung-berlin',label:'Räumung & Auflösung',slug:'wohnungsaufloesung-berlin',links:['wohnungsaufloesung-berlin','haushaltsaufloesung-berlin','nachlassaufloesung-berlin','entruempelung-berlin']}
];
const service = (slug:string) => {const found=publishedServices.find(s=>s.slug===slug);if(!found)throw new Error('Unbekannte Startseitenleistung: '+slug);return found;};
---
<Base title={page.title} description={page.metaDescription} path="/" schema={schema}>
  <Hero />
  <section class="reassurance" aria-label="So arbeiten wir">
    <div class="wrap reassurance__inner">
      <span><Icon name="check" size={18} /> Persönlich abstimmen</span><span><Icon name="doc" size={18} /> Umfang vorab festhalten</span><span><Icon name="home" size={18} /> Berlin &amp; Umland</span>
      {site.ratings.verified && <a class="reassurance__review" href={site.ratings.sourceUrl} rel="noopener noreferrer"><span aria-hidden="true">★★★★★</span><strong>{site.ratings.ratingValue.toLocaleString('de-DE')} / 5</strong> aus {site.ratings.reviewCount} Google-Bewertungen <small>Stand {formatDate(site.ratings.checked)}</small></a>}
    </div>
  </section>
  <section class="section home-services" aria-labelledby="leistungen-start">
    <div class="wrap">
      <div class="section-intro"><div><p class="eyebrow">Was steht bei Ihnen an?</p><h2 id="leistungen-start">Kleine Aufgabe.<br />Großes Vorhaben.<br /><em>Wir hören erst einmal zu.</em></h2></div><p>Sie müssen weder das richtige Gewerk kennen noch schon alles ausgemessen haben. Wählen Sie einen Einstieg – den Rest klären wir gemeinsam.</p></div>
      <div class="service-stories">{paths.map((group)=><article class="service-story">
        <a href={'/angebot-anfragen/?leistung='+group.slug} class="service-story__visual" aria-label={group.label+' anfragen'}>{heroImage(group.image)&&<Figure image={heroImage(group.image)!} layout="inline" class="service-story__image" />}</a>
        <div class="service-story__body"><p class="service-story__label">{group.label}</p><h3>{group.title}</h3><p>{group.text}</p><ul>{group.links.map(slug=><li><a href={'/leistungen/'+slug+'/'}>{service(slug).navLabel}<span aria-hidden="true">↗</span></a></li>)}</ul><a class="service-story__request" href={'/angebot-anfragen/?leistung='+group.slug}>Dazu eine Anfrage stellen <span aria-hidden="true">→</span></a></div>
      </article>)}</div>
      <details class="all-services"><summary>Alle Leistungen im Überblick <span aria-hidden="true">+</span></summary><div class="all-services__groups">{publishedCategories.map(category=><div><h3>{category.title}</h3><ul>{category.services.map(slug=><li><a href={'/leistungen/'+slug+'/'}>{service(slug).navLabel}</a></li>)}</ul></div>)}</div><a href="/leistungen/">Zur Leistungsübersicht →</a></details>
    </div>
  </section>
  <section class="section" aria-labelledby="home-planung"><div class="wrap"><p class="eyebrow">Aus einer Idee wird ein klarer Umfang</p><h2 id="home-planung">Erst messen. Dann anfragen.</h2><p>Unser <a href="/werkzeuge/wandflaechenrechner/">Wandflächenrechner</a> trennt Wände, Fenster und Decken. Für mehrere Gewerke hilft die <a href="/ratgeber/innenausbau-angebote-vergleichen/">Checkliste für vergleichbare Ausbau-Angebote</a>. Ohne erfundene Preise, mit Angaben, die im Gespräch weiterhelfen.</p></div></section>
  <section class="section thoughtful" aria-labelledby="mitgedacht">
    <div class="wrap thoughtful__layout">
      <div class="thoughtful__image">{heroImage('service:seniorenumzug-berlin')&&<Figure image={heroImage('service:seniorenumzug-berlin')!} layout="wide" />}</div>
      <div><p class="eyebrow">Wenn mehr dranhängt</p><h2 id="mitgedacht">Manche Aufgaben brauchen<br /><em>mehr als helfende Hände.</em></h2><p>Ein Umzug im Alter. Ein Nachlass. Eine Wohnung, die zur Übergabe leer sein muss. Wir nehmen uns Zeit, das Vorhaben mit Ihnen zu ordnen.</p><div class="thoughtful__links"><a href="/leistungen/seniorenumzug-berlin/"><strong>Seniorenumzug</strong><span>Mitgenommenes, neue Wohnung und Übergabe zusammen planen.</span><b aria-hidden="true">↗</b></a><a href="/leistungen/nachlassaufloesung-berlin/"><strong>Nachlassauflösung</strong><span>Erinnerungsstücke und Unterlagen vor der Räumung festlegen.</span><b aria-hidden="true">↗</b></a><a href="/leistungen/messiwohnung-raeumen/"><strong>Stark zugestellte Räume</strong><span>Diskret besprechen, was nötig und möglich ist.</span><b aria-hidden="true">↗</b></a></div></div>
    </div>
  </section>
  <section class="section steps-section" aria-labelledby="so-gehts">
    <div class="wrap"><div class="section-intro"><div><p class="eyebrow">So wird aus einem Plan ein Anfang</p><h2 id="so-gehts">Sie müssen nicht<br /><em>alles allein sortieren.</em></h2></div><p>Ein klarer Ablauf. Ohne Nutzerkonto, ohne automatische Buchung und ohne einen Preis, der Ihr Vorhaben noch gar nicht kennt.</p></div>
      <ol class="human-steps"><li><span>01</span><h3>Erzählen, was ansteht.</h3><p>Wählen Sie die Leistung und beantworten Sie die passenden Fragen. Fotos sind freiwillig.</p></li><li><span>02</span><h3>Gemeinsam konkret werden.</h3><p>Wir schauen Ihre Angaben an und klären offene Fragen, Material und benötigte Arbeiten.</p></li><li><span>03</span><h3>In Ruhe entscheiden.</h3><p>Umfang, Preis und Termin werden vor einem Auftrag abgestimmt. Sie entscheiden auf dieser Grundlage.</p></li></ol>
      <div class="scope-note"><Icon name="doc" size={24} /><div><h3>Ein Angebot soll verständlich sein.</h3><p>Arbeit, Material, Anfahrt, Vorbereitung und Entsorgung werden für Ihr Vorhaben geklärt. Die Anfrage ist eine Grundlage fürs Gespräch – noch kein verbindlicher Preis und kein bestätigter Termin.</p><a href="/kosten/">Was Kosten und Ablauf beeinflusst →</a></div></div>
    </div>
  </section>
  <section class="business-band"><div class="wrap"><div><p class="eyebrow">Auch für Betriebe &amp; Verwaltungen</p><h2>Eine Immobilie. Viele Aufgaben.</h2><p>Räumung, Büroauflösung und Übergabe mit klaren Leistungspositionen abstimmen.</p></div><div class="business-band__links"><a href="/hausverwaltungen-immobilienpartner/">Für Hausverwaltungen ↗</a><a href="/leistungen/bueroaufloesung-berlin/">Büroauflösung ↗</a></div></div></section>
  <section class="section home-faq"><div class="wrap wrap--mid"><p class="eyebrow">Noch eine Frage?</p><h2>Gut zu wissen,<br /><em>bevor es losgeht.</em></h2><Faq items={homeFaq} id="faq-home" /><p class="home-faq__more">Mehr Antworten finden Sie in unseren <a href="/fragen/">häufigen Fragen</a> und im <a href="/ratgeber/">Ratgeber</a>.</p></div></section>
  <section class="final-invite"><div class="wrap"><p class="eyebrow">Der erste Schritt darf einfach sein</p><h2>Was möchten Sie<br /><em>von Ihrer Liste streichen?</em></h2><p>Erzählen Sie uns von Ihrem Vorhaben. Noch offene Fragen sind willkommen.</p><div class="btn-row"><a class="btn btn--primary" href="/angebot-anfragen/" data-track="estimate_cta_click" data-track-location="home-abschluss">Unverbindlich anfragen ↗</a>{whatsapp.available&&<a class="btn btn--secondary" href={whatsapp.href} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-location="home-abschluss">Erst per WhatsApp schreiben</a>}</div><p class="final-invite__region">Wir helfen in <a href="/berlin/">Berlin</a> und im <a href="/brandenburg/">Berliner Umland</a>. <a href="/ueber-uns/">Mehr über Schnellhelfer24</a></p></div></section>
</Base>
<style>
h2{font-size:clamp(1.9rem,3.2vw,2.8rem);line-height:1.15;letter-spacing:-.04em;}h2 em{font-family:Georgia,'Times New Roman',serif;font-weight:500;letter-spacing:-.025em;}
.reassurance{border-block:1px solid var(--line);padding:1.2rem 0;}.reassurance__inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;font-size:.8rem;}.reassurance__inner>span{display:flex;align-items:center;gap:.5rem;font-weight:650;}.reassurance__review{display:flex;flex-wrap:wrap;gap:.35rem .5rem;align-items:center;text-decoration:none;}.reassurance__review>span{color:var(--accent-text);letter-spacing:.1em;}.reassurance__review small{display:block;font-size:.65rem;}
.section-intro{display:grid;gap:1rem;align-items:end;margin-bottom:2rem;}.section-intro h2{margin:0;}.section-intro>p{max-width:30rem;color:var(--ink-2);margin:0;line-height:1.75;}.service-stories{display:grid;gap:1.5rem;}.service-story{min-width:0;border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden;background:var(--white);}.service-story__visual{display:block;text-decoration:none;}.service-story__visual :global(.figure){margin:0;}.service-story__visual :global(img){aspect-ratio:16/10;object-fit:cover;}.service-story__visual :global(.figure__caption){font-size:.67rem;padding:.55rem 1.3rem 0;margin:0;}.service-story__body{padding:1.3rem;}.service-story__label{font-size:.7rem;font-weight:750;color:var(--accent-text);margin-bottom:.4rem;}.service-story h3{font-size:1.6rem;letter-spacing:-.04em;margin:0 0 .7rem;}.service-story__body>p:not(.service-story__label){font-size:.92rem;color:var(--ink-2);line-height:1.6;}.service-story ul{padding:0;list-style:none;margin:1rem 0;}.service-story li{margin:0;}.service-story li a{display:flex;justify-content:space-between;gap:.7rem;align-items:center;border-bottom:1px solid var(--line);min-height:2.75rem;font-size:.84rem;text-decoration:none;}.service-story a:hover{color:var(--accent-text);}.service-story__request{display:flex;align-items:center;gap:.8rem;min-height:2.75rem;font-size:.82rem;font-weight:750;text-decoration:none;}.all-services{border:1px solid var(--line);border-radius:var(--r-md);padding:1.2rem 1.4rem;margin-top:1.5rem;background:var(--paper-2);}.all-services summary{display:flex;justify-content:space-between;gap:1rem;cursor:pointer;font-weight:650;min-height:2rem;}.all-services__groups{display:grid;gap:1.2rem;margin:1.5rem 0;}.all-services h3{font-size:.9rem;}.all-services ul{list-style:none;padding:0;}.all-services li a{display:inline-block;font-size:.82rem;padding:.45rem 0;}
.thoughtful{background:var(--paper-2);}.thoughtful__layout{display:grid;gap:2rem;align-items:center;}.thoughtful__image :global(.figure){margin:0;}.thoughtful__image :global(img){border-radius:var(--r-lg);}.thoughtful__image :global(.figure__caption){font-size:.7rem;}.thoughtful__links{display:grid;gap:.3rem;margin-top:1.4rem;}.thoughtful__links a{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.25rem 1rem;text-decoration:none;border-bottom:1px solid var(--line-strong);padding:1rem 0;}.thoughtful__links strong{font-size:.95rem;}.thoughtful__links span{font-size:.82rem;color:var(--ink-2);grid-column:1;}.thoughtful__links b{grid-column:2;grid-row:1/3;align-self:center;}
.human-steps{list-style:none;display:grid;gap:1.5rem;padding:0;margin:2rem 0;}.human-steps li{padding:1.8rem;background:var(--paper-2);border-radius:var(--r-lg);}.human-steps li>span{display:inline-grid;place-items:center;width:2.5rem;height:2.5rem;border:1px solid var(--line-contrast);border-radius:50%;font-size:.8rem;font-weight:650;}.human-steps h3{font-size:1.2rem;margin:1.2rem 0 .65rem;}.human-steps p{font-size:.9rem;color:var(--ink-2);margin:0;}.scope-note{display:flex;align-items:flex-start;gap:1.2rem;border-top:1px solid var(--line);padding-top:1.6rem;}.scope-note :global(svg){flex:none;margin-top:.2rem;}.scope-note h3{font-size:1.1rem;margin:0 0 .5rem;}.scope-note p{font-size:.9rem;max-width:54rem;color:var(--ink-2);}.scope-note a{font-size:.85rem;font-weight:650;}
.business-band{padding:2.6rem 0;background:var(--brand);color:var(--white);}.business-band>.wrap{display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap;}.business-band .eyebrow{color:var(--on-dark);}.business-band h2{font-size:1.7rem;color:var(--white);margin:.5rem 0;}.business-band p{color:var(--on-dark);font-size:.9rem;margin:0;}.business-band__links{display:grid;gap:.7rem;}.business-band__links a{color:var(--white);padding:.65rem 0;font-size:.9rem;font-weight:650;}
.home-faq h2{margin-bottom:1.7rem;}.home-faq__more{font-size:.85rem;color:var(--ink-2);margin-top:1.5rem;}.final-invite{padding:4rem 0;background:var(--paper-2);text-align:center;}.final-invite h2{margin:.7rem 0 1rem;}.final-invite>.wrap>p:not(.eyebrow){color:var(--ink-2);}.final-invite .btn-row{justify-content:center;margin:1.8rem 0;}.final-invite__region{font-size:.78rem;}
@media(min-width:52em){.section-intro{grid-template-columns:1.2fr 1fr;gap:4rem;}.service-stories{grid-template-columns:repeat(3,minmax(0,1fr));}.all-services__groups{grid-template-columns:repeat(4,minmax(0,1fr));}.human-steps{grid-template-columns:repeat(3,minmax(0,1fr));}.thoughtful__layout{grid-template-columns:1fr 1fr;gap:4rem;}}
@media(max-width:39.99em){.section{padding-block:3rem;}.reassurance__review{border-top:1px solid var(--line);padding-top:1rem;width:100%;}.section-intro{margin-bottom:1.5rem;}.final-invite{padding:3rem 0;}.final-invite .btn-row{display:grid;}.scope-note{gap:.75rem;}}
</style>
