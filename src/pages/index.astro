---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { publishedServices } from '../data/services';
import { faqGroups } from '../data/faq';
import { buildGraph, organizationNode, websiteNode, webPageNode, faqNode } from '../lib/schema';
import { primaryCta } from '../lib/contact';

const title = 'Entrümpelung, Auflösung & Umzug in Berlin | Schnellhelfer24';
const description =
  'Entrümpelung, Haushaltsauflösung und Umzug in Berlin und im Umland. Persönliche Einschätzung nach Fotos oder Besichtigung und klare Absprache vor Beginn.';
const path = '/';

const homeFaq = [
  faqGroups[0].items[0],
  faqGroups[0].items[1],
  faqGroups[1].items[0],
  faqGroups[2].items[0],
];

const schema = buildGraph([
  organizationNode(),
  websiteNode(),
  webPageNode({
    url: path,
    name: title,
    description,
    dateModified: '2026-07-30',
  }),
  faqNode(path, homeFaq),
]);

const featured = publishedServices.slice(0, 6);
---

<Base title={title} description={description} path={path} schema={schema}>
  <Hero />

  <section class="work" aria-labelledby="arbeit">
    <div class="wrap work__grid">
      <div class="work__intro">
        <p class="eyebrow">Was wir übernehmen</p>
        <h2 id="arbeit">Alles raus.<br />Sauber übergeben.</h2>
        <p>
          Vom einzelnen Keller bis zur kompletten Wohnung. Wir tragen, laden, transportieren und
          entsorgen – in Berlin und im Umland.
        </p>
        <a class="text-link" href="/leistungen/">Alle Leistungen ansehen <span aria-hidden="true">↗</span></a>
      </div>

      <ol class="service-list">
        {
          featured.map((service, index) => (
            <li>
              <a href={`/leistungen/${service.slug}/`}>
                <span class="service-list__number">{String(index + 1).padStart(2, '0')}</span>
                <span>
                  <strong>{service.navLabel}</strong>
                  <small>{service.teaser}</small>
                </span>
                <span class="service-list__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="process" aria-labelledby="ablauf">
    <div class="wrap">
      <div class="process__head">
        <p class="eyebrow">Kein Preisraten am Telefon</p>
        <h2 id="ablauf">Erst ansehen.<br />Dann fest absprechen.</h2>
      </div>
      <ol class="process__steps">
        <li>
          <span>01</span>
          <h3>Zeigen</h3>
          <p>Fotos schicken oder einen kostenlosen Besichtigungstermin vereinbaren.</p>
        </li>
        <li>
          <span>02</span>
          <h3>Klären</h3>
          <p>Sie erfahren vorab, was gemacht wird, wie lange es dauert und was enthalten ist.</p>
        </li>
        <li>
          <span>03</span>
          <h3>Machen</h3>
          <p>Wir räumen, transportieren ab und übergeben wie vereinbart – auf Wunsch besenrein.</p>
        </li>
      </ol>
      <a class="btn btn--primary process__cta" href={primaryCta.href}>
        <Icon name="camera" size={19} />
        Auftrag kurz zeigen
      </a>
    </div>
  </section>

  <section class="straight" aria-labelledby="klartext">
    <div class="wrap straight__grid">
      <div>
        <p class="eyebrow">Klartext</p>
        <h2 id="klartext">Was Sie von uns nicht hören werden.</h2>
      </div>
      <div class="straight__copy">
        <p>
          Keine erfundenen Ab-Preise. Keine angeblichen Zertifikate. Keine „24/7“-Versprechen,
          wenn niemand ans Telefon geht.
        </p>
        <p>
          Wir schauen uns den Auftrag an, sagen ehrlich, was machbar ist, und halten die Absprache
          vor Beginn fest. Mehr braucht es meistens nicht.
        </p>
      </div>
    </div>
  </section>

  <section class="faq-home" aria-labelledby="faq-home">
    <div class="wrap faq-home__grid">
      <div>
        <p class="eyebrow">Kurz beantwortet</p>
        <h2>Fragen vor dem ersten Anruf</h2>
        <a class="text-link" href="/fragen/">Alle Fragen ansehen <span aria-hidden="true">↗</span></a>
      </div>
      <Faq items={homeFaq} title="Häufige Fragen" id="faq-home" openFirst />
    </div>
  </section>

  <CtaBand
    location="home-footer"
    headline="Was muss weg?"
    text="Schicken Sie ein paar Fotos, die Etage und Ihren Wunschtermin. Wir melden uns persönlich."
  />
</Base>

<style>
  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent-text);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .work {
    padding-block: clamp(4rem, 8vw, 8rem);
    background: var(--paper);
  }
  .work__grid {
    display: grid;
    gap: 3rem;
  }
  .work__intro {
    align-self: start;
  }
  .work h2,
  .process h2,
  .straight h2,
  .faq-home h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.3rem, 5vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }
  .work__intro > p:not(.eyebrow) {
    max-width: 28rem;
    color: var(--ink-2);
  }
  @media (min-width: 60em) {
    .work__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(4rem, 8vw, 9rem);
    }
    .work__intro {
      position: sticky;
      top: 2rem;
    }
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .service-list li {
    margin: 0;
    border-bottom: 1px solid var(--line-strong);
  }
  .service-list a {
    display: grid;
    grid-template-columns: 2.4rem 1fr 2rem;
    gap: 1rem;
    align-items: start;
    padding: 1.4rem 0;
    color: var(--ink);
    text-decoration: none;
  }
  .service-list a:hover strong {
    color: var(--accent-text);
  }
  .service-list__number {
    padding-top: 0.15rem;
    color: var(--ink-3);
    font: 700 0.75rem/1 var(--font-mono);
  }
  .service-list strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    line-height: 1.15;
  }
  .service-list small {
    display: block;
    max-width: 34rem;
    color: var(--ink-3);
    line-height: 1.45;
  }
  .service-list__arrow {
    color: var(--accent);
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.15s ease;
  }
  .service-list a:hover .service-list__arrow {
    transform: translateX(0.3rem);
  }

  .process {
    padding-block: clamp(4rem, 8vw, 8rem);
    background: var(--ink);
    color: var(--white);
  }
  .process h2,
  .process h3 {
    color: var(--white);
  }
  .process__head {
    max-width: 58rem;
  }
  .process__steps {
    display: grid;
    list-style: none;
    margin: clamp(3rem, 6vw, 5rem) 0 2.5rem;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
  }
  .process__steps li {
    margin: 0;
    padding: 1.5rem 0 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  }
  .process__steps span {
    color: var(--on-dark-accent);
    font: 700 0.78rem/1 var(--font-mono);
  }
  .process__steps h3 {
    margin: 1rem 0 0.5rem;
    font-size: 1.6rem;
  }
  .process__steps p {
    margin: 0;
    max-width: 24rem;
    color: var(--on-dark);
  }
  @media (min-width: 48em) {
    .process__steps {
      grid-template-columns: repeat(3, 1fr);
    }
    .process__steps li {
      padding: 1.75rem 2rem 2rem 0;
      border-bottom: 0;
    }
    .process__steps li + li {
      padding-left: 2rem;
      border-left: 1px solid rgba(255, 255, 255, 0.25);
    }
  }

  .straight {
    padding-block: clamp(4rem, 8vw, 8rem);
    background: var(--accent);
    color: var(--white);
  }
  .straight .eyebrow {
    color: var(--white);
  }
  .straight h2 {
    color: var(--white);
    max-width: 11ch;
  }
  .straight__grid {
    display: grid;
    gap: 2rem;
  }
  .straight__copy {
    max-width: 37rem;
    align-self: end;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.45;
  }
  .straight__copy p:last-child {
    margin-bottom: 0;
  }
  @media (min-width: 60em) {
    .straight__grid {
      grid-template-columns: 1fr 0.8fr;
      gap: 5rem;
    }
  }

  .faq-home {
    padding-block: clamp(4rem, 8vw, 8rem);
  }
  .faq-home__grid {
    display: grid;
    gap: 3rem;
  }
  .faq-home h2 {
    font-size: clamp(2rem, 4vw, 3.7rem);
  }
  @media (min-width: 60em) {
    .faq-home__grid {
      grid-template-columns: 0.75fr 1.25fr;
      gap: 6rem;
    }
  }

  .text-link {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    padding-block: 0.35rem;
    font-weight: 750;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
  }
</style>
