---
import type { Guide } from '../data/types';
import Blocks from './Blocks.astro';
import Faq from './Faq.astro';
import ContactCard from './ContactCard.astro';
import { relatedGuides } from '../data/guides';
import { getService } from '../data/services';
import { formatDate } from '../lib/text';
import { site } from '../config/site';

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;

const related = relatedGuides(guide.related);
const svcs = guide.services
  .map((s) => getService(s))
  .filter((s): s is NonNullable<typeof s> => Boolean(s) && s!.status === 'published');

// Inhaltsverzeichnis aus den Blocküberschriften
const toc = guide.blocks.map((b) => ({
  label: b.h,
  id: b.h
    .toLowerCase()
    .replace(/[^a-z0-9äöüß]+/g, '-')
    .replace(/^-|-$/g, ''),
}));
---

<div class="grid grid--sidebar">
  <article class="prose">
    <h1>{guide.h1}</h1>

    <p class="byline">
      Von {site.name} · Aktualisiert am {formatDate(guide.updated)}
    </p>

    <div class="answer">
      <p>{guide.answer}</p>
    </div>

    {
      toc.length > 2 && (
        <nav class="toc" aria-labelledby="toc-head">
          <p class="toc__head" id="toc-head">
            Auf dieser Seite
          </p>
          <ol>
            {toc.map((t) => (
              <li>
                <a href={`#${t.id}`}>{t.label}</a>
              </li>
            ))}
            {guide.faq.length > 0 && (
              <li>
                <a href="#fragen-head">Häufige Fragen</a>
              </li>
            )}
          </ol>
        </nav>
      )
    }

    <Blocks blocks={guide.blocks} />

    <Faq items={guide.faq} id="fragen" />

    <p class="updated">
      Zuletzt aktualisiert am {formatDate(guide.updated)}, erstmals veröffentlicht am{' '}
      {formatDate(guide.published)}. Dieser Text beschreibt die Praxis in Berlin und ersetzt keine
      Rechts- oder Steuerberatung.
    </p>
  </article>

  <div class="sidebar">
    <ContactCard
      location={`ratgeber-${guide.slug}`}
      headline="Ihre Situation einschätzen lassen"
      text="Allgemeine Erklärungen helfen nur bis zu einem Punkt. Für Ihren Fall schauen wir uns die Fotos an."
    />

    {
      svcs.length > 0 && (
        <nav class="side-box" aria-labelledby="side-svc">
          <h2 class="side-box__head" id="side-svc">
            Passende Leistungen
          </h2>
          <ul>
            {svcs.map((s) => (
              <li>
                <a href={`/leistungen/${s.slug}/`}>{s.navLabel}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      related.length > 0 && (
        <nav class="side-box" aria-labelledby="side-rel">
          <h2 class="side-box__head" id="side-rel">
            Weiterlesen
          </h2>
          <ul>
            {related.map((g) => (
              <li>
                <a href={`/${g.hub}/${g.slug}/`}>{g.h1}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</div>

<style>
  .byline {
    font-size: 0.88rem;
    color: var(--ink-4);
    margin-top: -0.5rem;
    margin-bottom: var(--sp-5);
  }

  .toc {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--sp-4) var(--sp-5);
    background: var(--white);
    margin-bottom: var(--sp-6);
  }
  .toc__head {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 var(--sp-3);
    font-weight: 700;
  }
  .toc ol {
    margin: 0;
    padding-left: 1.15rem;
  }
  .toc li {
    margin-bottom: 0.35rem;
  }
  .toc li::marker {
    color: var(--ink-4);
    font-size: 0.85rem;
  }
  .toc a {
    color: var(--brand-3);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .toc a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .sidebar {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }
  .side-box {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--sp-4) var(--sp-5);
    background: var(--white);
  }
  .side-box__head {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 var(--sp-3);
  }
  .side-box ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .side-box li {
    margin: 0;
    border-top: 1px solid var(--paper-3);
  }
  .side-box li:first-child {
    border-top: 0;
  }
  .side-box a {
    display: block;
    padding: 0.55rem 0;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.94rem;
    min-height: 2.5rem;
  }
  .side-box a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
