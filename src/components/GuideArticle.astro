---
import type { Guide } from '../data/types';
import Blocks from './Blocks.astro';
import Faq from './Faq.astro';
import ContactCard from './ContactCard.astro';
import RelatedServiceLinks from './RelatedServiceLinks.astro';
import RelatedGuides from './RelatedGuides.astro';
import NextStepPanel from './NextStepPanel.astro';
import ContextualCompanyLink from './ContextualCompanyLink.astro';
import { formatDate } from '../lib/text';
import { site } from '../config/site';
import { seoPage } from '../data/seo-pages';

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;

const answerParagraphs = guide.answer.split(/\n\s*\n/).filter(Boolean);

const pageId = `guide:${guide.slug}`;
const seo = seoPage(pageId);

/**
 * Auftrag § 4: Ein Ratgeber führt auf GENAU EINE passende Leistungsseite,
 * nicht wahllos auf mehrere. Welche das ist, steht als erster Eintrag in
 * `requiredOutboundLinks` der Seitenkarte – dort ist die Entscheidung
 * getroffen und nachlesbar, statt sie in der Reihenfolge eines Arrays in
 * guides.ts zu verstecken.
 */
const nextStepLinks = seo.requiredOutboundLinks
  .filter((id) => id !== 'angebot-anfragen')
  .map((id) => {
    const target = seoPage(id);
    return { href: target.url, label: target.h1 };
  });

/** Nur bei Themen, bei denen die Frage nach dem Betrieb wirklich aufkommt. */
const COMPANY_LINK_ON: Record<string, 'trauerfall' | 'senioren'> = {
  'haushaltsaufloesung-nach-todesfall': 'trauerfall',
  'kosten-seniorenumzug-berlin': 'senioren',
};
const companyLinkContext = COMPANY_LINK_ON[guide.slug];

// Inhaltsverzeichnis aus den Blocküberschriften
const toc = guide.blocks.map((b) => ({
  label: b.h,
  id: b.h
    .toLowerCase()
    .replace(/[^a-z0-9äöüß]+/g, '-')
    .replace(/^-|-$/g, ''),
}));
---

<div class="grid grid--sidebar">
  <article class="prose">
    <h1>{guide.h1}</h1>

    <p class="byline">
      Von {site.name} · Aktualisiert am {formatDate(guide.updated)}
    </p>

    <div class="answer">
      {answerParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {
      toc.length > 2 && (
        <nav class="toc" aria-labelledby="toc-head">
          <p class="toc__head" id="toc-head">
            Auf dieser Seite
          </p>
          <ol>
            {toc.map((t) => (
              <li>
                <a href={`#${t.id}`}>{t.label}</a>
              </li>
            ))}
            {guide.faq.length > 0 && (
              <li>
                <a href="#fragen-head">Häufige Fragen</a>
              </li>
            )}
          </ol>
        </nav>
      )
    }

    <Blocks blocks={guide.blocks} />

    {
      guide.download && (
        <aside class="download-box" aria-labelledby="download-head">
          <p class="download-box__kicker">Kostenlos herunterladen</p>
          <h2 id="download-head">{guide.download.label}</h2>
          <p>{guide.download.description}</p>
          <a
            class="btn btn--primary"
            href={guide.download.href}
            download
            data-track="guide_download"
            data-track-location={`ratgeber-${guide.slug}`}
          >
            PDF herunterladen
          </a>
        </aside>
      )
    }

    <Faq items={guide.faq} id="fragen" />

    {
      guide.sources && guide.sources.length > 0 && (
        <section class="sources" aria-labelledby="sources-head">
          <h2 id="sources-head">Quellen und Prüfstand</h2>
          <p>
            Behördliche und rechtliche Angaben wurden am {formatDate(guide.updated)} geprüft. Bei
            Ihrem Einzelfall ist die Auskunft der zuständigen Stelle maßgeblich.
          </p>
          <ul>
            {guide.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener">
                  {source.label}
                </a>{' '}
                – {source.publisher}, geprüft am {formatDate(source.checked)}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {companyLinkContext && <ContextualCompanyLink context={companyLinkContext} />}

    <NextStepPanel pageId={pageId} links={nextStepLinks} />

    <p class="updated">
      Zuletzt aktualisiert am {formatDate(guide.updated)}, erstmals veröffentlicht am{' '}
      {formatDate(guide.published)}. Dieser Text beschreibt die Praxis in Berlin und ersetzt keine
      Rechts- oder Steuerberatung.
    </p>
  </article>

  <div class="sidebar">
    <ContactCard
      location={`ratgeber-${guide.slug}`}
      headline="Ihre Situation einschätzen lassen"
      text="Allgemeine Erklärungen helfen nur bis zu einem Punkt. Für Ihren Fall schauen wir uns die Fotos an."
    />

    <RelatedServiceLinks slugs={guide.services} heading="Passende Leistungen" />

    <RelatedGuides slugs={guide.related} heading="Weiterlesen" />

  </div>
</div>

<style>
  .byline {
    font-size: 0.88rem;
    color: var(--ink-4);
    margin-top: -0.5rem;
    margin-bottom: var(--sp-5);
  }

  .toc {
    border: 1px solid var(--line);
    border-top: 3px solid var(--ink);
    padding: var(--sp-4) var(--sp-5);
    background: var(--paper-2);
    margin-bottom: var(--sp-6);
  }
  .toc__head {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 var(--sp-3);
    font-weight: 800;
  }
  .toc ol {
    margin: 0;
    padding-left: 1.15rem;
  }
  .toc li {
    margin-bottom: 0.35rem;
  }
  .toc li::marker {
    color: var(--ink-4);
    font-size: 0.85rem;
  }
  .toc a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .toc a:hover {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .sidebar {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }

  .download-box {
    border: 3px solid var(--ink);
    border-left-color: var(--accent);
    padding: var(--sp-5);
    margin: var(--sp-6) 0;
    background: var(--paper-2);
  }
  .download-box__kicker {
    margin: 0 0 var(--sp-2);
    color: var(--accent-text);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .download-box h2 {
    margin-top: 0;
  }
  .sources {
    border-top: 1px solid var(--line);
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
  }
  .sources h2 {
    font-size: 1.25rem;
  }
  .sources li {
    margin-bottom: var(--sp-2);
  }
</style>
