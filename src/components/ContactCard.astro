---
import Icon from './Icon.astro';
import { phone, whatsapp, primaryCta } from '../lib/contact';

/**
 * Kompakter Kontaktblock für die Seitenspalte.
 * Zeigt nur Wege, die tatsächlich hinterlegt sind.
 */
interface Props {
  location?: string;
  headline?: string;
  text?: string;
}
const {
  location = 'sidebar',
  headline = 'Aufwand einschätzen lassen',
  text = 'Fotos schicken oder Besichtigung vereinbaren. Kostenlos und unverbindlich.',
} = Astro.props;
---

<aside class="ccard" aria-labelledby={`ccard-${location}`}>
  <h2 class="ccard__head" id={`ccard-${location}`}>{headline}</h2>
  <p class="ccard__text">{text}</p>

  <a class="btn btn--primary btn--wide" href={primaryCta.href} data-track="estimate_cta_click" data-track-location={location}>
    <Icon name="camera" size={18} />
    Fotos senden
  </a>

  {
    phone.available && (
      <a class="ccard__line" href={phone.href} data-track="phone_click" data-track-location={location}>
        <Icon name="phone" size={18} />
        <span>
          <strong>{phone.display}</strong>
          <small>Direkt anrufen</small>
        </span>
      </a>
    )
  }
  {
    whatsapp.available && (
      <a
        class="ccard__line"
        href={whatsapp.href}
        target="_blank"
        rel="noopener"
        data-track="whatsapp_click"
        data-track-location={location}
      >
        <Icon name="whatsapp" size={18} />
        <span>
          <strong>WhatsApp</strong>
          <small>Fotos direkt senden</small>
        </span>
      </a>
    )
  }
  {
    !phone.available && (
      <a class="ccard__line" href="/kontakt/">
        <Icon name="mail" size={18} />
        <span>
          <strong>Kontaktseite</strong>
          <small>Alle Wege zu uns</small>
        </span>
      </a>
    )
  }
</aside>

<style>
  .ccard {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    padding: var(--sp-5);
    position: relative;
  }
  .ccard__head {
    font-size: 1.08rem;
    margin: 0 0 var(--sp-2);
  }
  .ccard__text {
    font-size: 0.92rem;
    color: var(--ink-2);
    margin-bottom: var(--sp-4);
  }
  .ccard__line {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
    padding: 0.6rem 0.25rem;
    color: var(--ink);
    text-decoration: none;
    border-top: 1px solid var(--line-strong);
    min-height: 2.75rem;
  }
  .ccard__line:hover {
    color: var(--accent-text);
  }
  .ccard__line :global(svg) {
    color: var(--accent);
    flex: none;
  }
  .ccard__line strong {
    display: block;
    font-size: 0.98rem;
    color: inherit;
  }
  .ccard__line small {
    display: block;
    color: var(--ink-3);
    font-size: 0.82rem;
  }

  @media (min-width: 62em) {
    .ccard {
      position: sticky;
      top: var(--sp-5);
    }
  }
</style>
