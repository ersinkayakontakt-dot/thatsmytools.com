---
import Icon from './Icon.astro';
import { phone, whatsapp, primaryCta } from '../lib/contact';
---

<section class="hero">
  <div class="hero__label" aria-hidden="true">
    <span>BERLIN + UMLAND</span>
    <span>AUFLÖSEN · UMZIEHEN · ÜBERGEBEN</span>
  </div>

  <div class="wrap hero__inner">
    <p class="hero__place">Komplettservice aus einer Hand</p>
    <h1>
      Wohnungsauflösung,<br />
      Nachlass und<br />
      <span>Seniorenumzug</span> in Berlin
    </h1>
    <p class="hero__sub">
      Wir organisieren komplette Räumungen und Wohnungswechsel – von der ersten Sichtung bis zur
      besenreinen Übergabe. Persönlich koordiniert, diskret durchgeführt und auch für Angehörige
      außerhalb Berlins.
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href={primaryCta.href} data-track="estimate_cta_click" data-track-location="hero">
        Komplettauftrag anfragen
        <span aria-hidden="true">→</span>
      </a>
      {
        phone.available ? (
          <a class="btn btn--secondary" href={phone.href} data-track="phone_click" data-track-location="hero">
            <Icon name="phone" size={19} />
            Projekt telefonisch besprechen
          </a>
        ) : (
          <a class="btn btn--secondary" href="/kontakt/">
            <Icon name="phone" size={19} />
            Projekt telefonisch besprechen
          </a>
        )
      }
      {
        whatsapp.available && (
          <a
            class="btn btn--ghost"
            href={whatsapp.href}
            target="_blank"
            rel="noopener"
            data-track="whatsapp_click"
            data-track-location="hero"
          >
            <Icon name="whatsapp" size={19} />
            Fotos und Eckdaten senden
          </a>
        )
      }
    </div>

    <ul class="hero__facts">
      <li><strong>01</strong><span>Eine Ansprechperson<br />vom Termin bis zur Übergabe</span></li>
      <li><strong>02</strong><span>Fester Leistungsumfang<br />vor Beginn abgestimmt</span></li>
      <li><strong>03</strong><span>Besenrein übergeben,<br />auf Wunsch mit Fotoprotokoll</span></li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(49rem, calc(100vh - 4.5rem));
    background: #eef0ed;
    border-bottom: 0;
  }
  .hero::after {
    content: '24';
    position: absolute;
    right: -0.04em;
    bottom: -0.24em;
    color: rgba(23, 49, 58, 0.055);
    font-size: clamp(18rem, 42vw, 42rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.11em;
    pointer-events: none;
  }
  .hero__label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem var(--sp-5);
    background: var(--ink);
    color: var(--white);
    font: 700 0.68rem/1.2 var(--font-mono);
    letter-spacing: 0.1em;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(3.5rem, 7vw, 7rem) 2.5rem;
  }
  .hero__place {
    margin: 0 0 1.3rem;
    color: var(--accent-text);
    font-size: 0.8rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  /*
   * Die Zeile trägt jetzt die Positionierung statt eines Zweiwortclaims.
   * Damit sie in drei Zeilen lesbar bleibt, ist der Schriftgrad kleiner und
   * die Zeilenhöhe größer als beim vorherigen "WIR MACHEN PLATZ" – der
   * Charakter (fett, versal, eng, Akzentwort) bleibt erhalten.
   */
  .hero h1 {
    max-width: 16ch;
    margin: 0 0 1.75rem;
    font-size: clamp(2.4rem, 6.1vw, 5rem);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .hero h1 span {
    color: var(--accent);
  }
  .hero__sub {
    max-width: 36rem;
    margin-bottom: 2rem;
    color: var(--ink-2);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    line-height: 1.45;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
  }
  .hero__actions :global(.btn) {
    border-radius: 0;
    min-height: 3.5rem;
    padding-inline: 1.6rem;
  }
  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    max-width: 43rem;
    margin: clamp(3.5rem, 8vw, 6rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .hero__facts li {
    display: flex;
    gap: 0.7rem;
    margin: 0;
    padding: 1rem 0.75rem 0 0;
    color: var(--ink-2);
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .hero__facts li + li {
    padding-left: 0.75rem;
    border-left: 1px solid var(--line-strong);
  }
  .hero__facts strong {
    color: var(--accent-text);
    font: 800 0.7rem/1.35 var(--font-mono);
  }
  @media (max-width: 34em) {
    .hero {
      min-height: auto;
    }
    .hero__label span:last-child {
      display: none;
    }
    .hero__facts {
      grid-template-columns: 1fr;
    }
    .hero__facts li,
    .hero__facts li + li {
      padding: 0.8rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--line-strong);
    }
  }
</style>
