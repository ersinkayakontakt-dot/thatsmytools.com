---
/**
 * ABLAUF IM ARTIKEL
 * =================
 * Kompakte, helle Fassung des Startseiten-Ablaufs für Leistungsseiten.
 * Steht direkt nach „Was den Preis bestimmt": Dort entsteht die Frage,
 * wie man von Preisfaktoren zu einem festen Preis kommt.
 *
 * BEWUSST OHNE KNOPF. Am Seitenende folgen NextStepPanel und CtaBand;
 * ein dritter Handlungsaufruf wäre genau die Wiederholung, die
 * NextStepPanel.astro ausschließt.
 *
 * Texte aus src/data/process.ts – dieselbe Quelle wie die Startseite.
 */
import { processSteps, finalGeneral } from '../data/process';

interface Props {
  /** Anker-ID der Überschrift, für die Sprungnavigation. */
  id?: string;
  heading?: string;
}
const { id = 'ablauf', heading = 'So kommen Sie zu einem festen Preis' } = Astro.props;

const steps = processSteps.map((step, i) =>
  i === processSteps.length - 1 ? { ...step, text: finalGeneral } : step,
);
---

<section class="proc" aria-labelledby={id}>
  <h2 id={id}>{heading}</h2>
  <ol class="proc__steps">
    {
      steps.map((step) => (
        <li>
          <span class="proc__nr" aria-hidden="true">{step.nr}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .proc {
    margin: var(--sp-7) 0;
  }
  .proc__steps {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    border-top: var(--rule-strong, 3px) solid var(--ink);
  }
  .proc__steps li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: var(--sp-3);
    /* Am Desktop sind die drei Spalten gleich hoch gestreckt. Ohne start
       verteilt die kürzeste Spalte den Leerraum auf ihre Zeilen, und ihre
       Überschrift rutscht tiefer als die der Nachbarn. */
    align-content: start;
    margin: 0;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .proc__nr {
    font: 700 0.85rem/1.6 var(--font-mono);
    color: var(--accent-text);
  }
  .proc h3 {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
  }
  .proc p {
    margin: 0;
    color: var(--ink-2);
  }
  @media (min-width: 48em) {
    .proc__steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--line);
    }
    .proc__steps li {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
      padding: var(--sp-4) var(--sp-4) var(--sp-5) 0;
      border-bottom: 0;
    }
    .proc__steps li + li {
      padding-left: var(--sp-4);
      border-left: 1px solid var(--line);
    }
  }
</style>
