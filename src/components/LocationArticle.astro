---
import type { District, Town } from '../data/types';
import Blocks from './Blocks.astro';
import Faq from './Faq.astro';
import Icon from './Icon.astro';
import ContactCard from './ContactCard.astro';
import Todo from './Todo.astro';
import { getService } from '../data/services';
import { casesForLocation } from '../data/cases';
import { formatDate } from '../lib/text';
import { checkLocation } from '../lib/publishGuard';

/**
 * Gemeinsame Darstellung für Bezirks- und Ortsseiten.
 * Die Struktur ist gleich, die Inhalte sind es ausdrücklich nicht:
 * Jede veröffentlichte Standortseite hat eigene Einleitung, eigene
 * Gebäude- und Zufahrtsangaben und eigene FAQ (siehe publishGuard.ts).
 */
interface Props {
  loc: District | Town;
  /** 'berlin' oder 'brandenburg' */
  hub: 'berlin' | 'brandenburg';
  indexable: boolean;
}
const { loc, hub, indexable } = Astro.props;
const guard = checkLocation(loc);
const cases = casesForLocation(loc.slug);
const focus = loc.focusServices
  .map((s) => getService(s))
  .filter((s): s is NonNullable<typeof s> => Boolean(s) && s!.status === 'published');
const quartersLabel = hub === 'berlin' ? 'Ortsteile im Bezirk' : 'Ortsteile';
---

{
  !indexable && (
    <div class="draft-banner" role="note">
      <strong>Entwurf.</strong> Diese Standortseite ist bewusst nicht veröffentlicht: noindex, nicht
      in der Sitemap, nirgends verlinkt. Sie geht erst online, wenn sie eigenständigen Inhalt hat.
      Offen: {guard.missing.join('; ')}.
    </div>
  )
}

<div class="grid grid--sidebar">
  <article class="prose">
    <h1>{loc.h1}</h1>

    <div class="answer">
      <p>{loc.answer}</p>
    </div>

    {loc.intro.map((p) => <p>{p}</p>)}

    {
      loc.quarters.length > 0 && (
        <section>
          <h2>{quartersLabel}</h2>
          <p>
            Wir arbeiten im gesamten Gebiet. Diese Ortsteile kommen bei Anfragen am häufigsten vor:
          </p>
          <ul class="chips">
            {loc.quarters.map((q) => (
              <li>
                <span class="chip">{q}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      loc.buildings.length > 0 && (
        <section>
          <h2>Welche Gebäude uns hier begegnen</h2>
          <p>
            Die Bauform entscheidet über den Aufwand oft stärker als die Wohnungsgröße. Was hier
            typisch ist:
          </p>
          <ul class="marked">
            {loc.buildings.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      loc.access.length > 0 && (
        <section>
          <h2>Zufahrt, Parken und Tragewege</h2>
          <p>
            Wo das Fahrzeug steht, ist einer der größten versteckten Kostenfaktoren. Was Sie hier
            wissen sollten:
          </p>
          <ul class="marked">
            {loc.access.map((a) => (
              <li>{a}</li>
            ))}
          </ul>
        </section>
      )
    }

    {loc.blocks && <Blocks blocks={loc.blocks} />}

    {
      focus.length > 0 && (
        <section>
          <h2>Hier besonders häufig angefragt</h2>
          <ul class="focus">
            {focus.map((s) => (
              <li>
                <a class="card card--link" href={`/leistungen/${s.slug}/`}>
                  <span class="focus__icon" aria-hidden="true">
                    <Icon name={s.icon} size={19} />
                  </span>
                  <span class="card__title">{s.navLabel}</span>
                  <span class="card__text">{s.teaser}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <h2>Einsätze in {loc.name}</h2>
      {
        cases.length > 0 ? (
          <ul class="linklist">
            {cases.map((c) => (
              <li>
                <a href={`/einsatzberichte/${c.slug}/`} data-track="case_study_opened">
                  {c.title}
                </a>
                <span class="linklist__meta">
                  {c.facts.objectType} · {c.facts.duration}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <>
            <p>
              Für {loc.name} sind hier noch keine Einsatzberichte veröffentlicht. Wir zeigen an
              dieser Stelle ausschließlich Aufträge, die tatsächlich stattgefunden haben und für die
              eine Freigabe vorliegt. Erfundene Referenzfälle würden Ihnen bei der Einschätzung Ihrer
              eigenen Situation nicht helfen.
            </p>
            <p>
              <a href="/einsatzberichte/">Was in einem Einsatzbericht stehen wird</a>
            </p>
            <Todo>
              Sobald ein Auftrag in {loc.name} abgeschlossen und vom Kunden freigegeben ist: Eintrag
              in <code>src/data/cases.ts</code> anlegen und in <code>{loc.slug}</code> unter{' '}
              <code>cases</code> verknüpfen.
            </Todo>
          </>
        )
      }
    </section>

    <Faq items={loc.faq} title={`Häufige Fragen zu ${loc.name}`} id={`faq-${loc.slug}`} />

    <p class="updated">
      Zuletzt aktualisiert am {formatDate(loc.updated)}. Angaben zu Bebauung und Zufahrt beruhen auf
      unseren Einsätzen vor Ort und ersetzen keine Prüfung Ihrer konkreten Adresse.
    </p>
  </article>

  <div class="sidebar">
    <ContactCard
      location={`standort-${loc.slug}`}
      headline={`Einsatz in ${loc.name} anfragen`}
      text="Schicken Sie Fotos aus jedem Raum, dazu Etage und Aufzug. Dann können wir den Aufwand einschätzen."
    />

    <nav class="side-box" aria-labelledby="side-svc">
      <h2 class="side-box__head" id="side-svc">Leistungen</h2>
      <ul>
        {
          focus.map((s) => (
            <li>
              <a href={`/leistungen/${s.slug}/`}>{s.navLabel}</a>
            </li>
          ))
        }
        <li><a href="/leistungen/">Alle Leistungen</a></li>
      </ul>
    </nav>

    <nav class="side-box" aria-labelledby="side-hub">
      <h2 class="side-box__head" id="side-hub">Weitere Gebiete</h2>
      <ul>
        <li><a href="/berlin/">Berliner Bezirke</a></li>
        <li><a href="/brandenburg/">Berliner Umland</a></li>
        <li><a href="/kosten/">Kosten und Preisfaktoren</a></li>
      </ul>
    </nav>
  </div>
</div>

<style>
  .draft-banner {
    background: var(--warn-tint);
    border: 2px dashed var(--warn);
    color: var(--warn);
    padding: var(--sp-3) var(--sp-4);
    margin-bottom: var(--sp-5);
    font-size: 0.92rem;
  }

  .marked li::marker {
    color: var(--accent);
  }

  .focus {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0;
    display: grid;
    gap: var(--sp-4);
  }
  @media (min-width: 34em) {
    .focus {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .focus li {
    margin: 0;
  }
  .focus a {
    height: 100%;
  }
  .focus__icon {
    display: block;
    color: var(--accent);
    margin-bottom: var(--sp-2);
  }

  .linklist {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0;
  }
  .linklist li {
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .linklist__meta {
    color: var(--ink-4);
    font-size: 0.88rem;
  }

  .sidebar {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }
  .side-box {
    border: 1px solid var(--line);
    border-top: 3px solid var(--ink);
    padding: var(--sp-4) var(--sp-5);
    background: var(--white);
  }
  .side-box__head {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 var(--sp-3);
  }
  .side-box ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .side-box li {
    margin: 0;
    border-top: 1px solid var(--paper-3);
  }
  .side-box li:first-child {
    border-top: 0;
  }
  .side-box a {
    display: block;
    padding: 0.55rem 0;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.94rem;
    min-height: 2.5rem;
  }
  .side-box a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
