---
import type { District, Town } from '../data/types';
import Blocks from './Blocks.astro';
import Faq from './Faq.astro';
import Icon from './Icon.astro';
import ContactCard from './ContactCard.astro';
import Todo from './Todo.astro';
import RelevantLocations from './RelevantLocations.astro';
import CaseStudyLinks from './CaseStudyLinks.astro';
import NextStepPanel from './NextStepPanel.astro';
import { getService } from '../data/services';
import { casesForLocation } from '../data/cases';
import { formatDate } from '../lib/text';
import { checkLocation } from '../lib/publishGuard';
import { seoPage } from '../data/seo-pages';

/**
 * Gemeinsame Darstellung für Bezirks- und Ortsseiten.
 * Die Struktur ist gleich, die Inhalte sind es ausdrücklich nicht:
 * Jede veröffentlichte Standortseite hat eigene Einleitung, eigene
 * Gebäude- und Zufahrtsangaben und eigene FAQ (siehe publishGuard.ts).
 */
interface Props {
  loc: District | Town;
  /** 'berlin' oder 'brandenburg' */
  hub: 'berlin' | 'brandenburg';
  indexable: boolean;
}
const { loc, hub, indexable } = Astro.props;
const guard = checkLocation(loc);
const cases = casesForLocation(loc.slug);
const quartersLabel = hub === 'berlin' ? 'Ortsteile im Bezirk' : 'Ortsteile';

const pageId = `${hub === 'berlin' ? 'district' : 'town'}:${loc.slug}`;

/**
 * Auftrag § 4: Eine Standortseite verlinkt auf die wichtigste dort
 * tatsächlich angebotene Leistung und auf höchstens zwei weitere.
 *
 * WELCHE Leistungen hier stehen, sagt `focusServices` in den Standortdaten.
 * Das ist eine inhaltliche Aussage über das Gebiet und wird nicht
 * verändert – eine Leistung hinzuzuerfinden, um den Autoritätsfluss zu
 * lenken, wäre eine Falschaussage über das Angebot.
 *
 * Verändert wird nur die REIHENFOLGE: nach wirtschaftlicher Priorität aus
 * der Seitenkarte, begrenzt auf drei. Damit steht die wertvollste
 * tatsächlich angebotene Leistung zuerst und bekommt die stärkste Position
 * im Fließtext.
 */
const focus = loc.focusServices
  .map((slug) => getService(slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s) && s!.status === 'published')
  .map((s) => ({ service: s, priority: seoPage(`service:${s.slug}`).businessPriority }))
  .sort((a, b) => b.priority - a.priority)
  .slice(0, 3)
  .map(({ service }) => service);
---

{
  !indexable && (
    <div class="draft-banner" role="note">
      <strong>Entwurf.</strong> Diese Standortseite ist bewusst nicht veröffentlicht: noindex, nicht
      in der Sitemap, nirgends verlinkt. Sie geht erst online, wenn sie eigenständigen Inhalt hat.
      Offen: {guard.missing.join('; ')}.
    </div>
  )
}

<div class="grid grid--sidebar">
  <article class="prose">
    <h1>{loc.h1}</h1>

    <div class="answer">
      <p>{loc.answer}</p>
    </div>

    {loc.intro.map((p) => <p>{p}</p>)}

    {
      loc.quarters.length > 0 && (
        <section>
          <h2>{quartersLabel}</h2>
          <p>
            {hub === 'berlin'
              ? 'Zum Bezirk gehören diese Ortsteile:'
              : 'Zu diesem Einsatzgebiet gehören unter anderem diese Ortsteile:'}
          </p>
          <ul class="chips">
            {loc.quarters.map((q) => (
              <li>
                <span class="chip">{q}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      loc.buildings.length > 0 && (
        <section>
          <h2>Welche Gebäude uns hier begegnen</h2>
          <p>
            Die Bauform entscheidet über den Aufwand oft stärker als die Wohnungsgröße. Was hier
            typisch ist:
          </p>
          <ul class="marked">
            {loc.buildings.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      loc.access.length > 0 && (
        <section>
          <h2>Zufahrt, Parken und Tragewege</h2>
          <p>
            Wo das Fahrzeug steht, ist einer der größten versteckten Kostenfaktoren. Was Sie hier
            wissen sollten:
          </p>
          <ul class="marked">
            {loc.access.map((a) => (
              <li>{a}</li>
            ))}
          </ul>
        </section>
      )
    }

    {loc.blocks && <Blocks blocks={loc.blocks} />}

    {
      focus.length > 0 && (
        <section>
          <h2>Hier besonders häufig angefragt</h2>
          <ul class="focus">
            {focus.map((s) => (
              <li>
                <a class="card card--link" href={`/leistungen/${s.slug}/`}>
                  <span class="focus__icon" aria-hidden="true">
                    <Icon name={s.icon} size={19} />
                  </span>
                  <span class="card__title">{s.navLabel}</span>
                  <span class="card__text">{s.teaser}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <h2>Einsätze in {loc.name}</h2>
      {
        cases.length > 0 ? (
          <CaseStudyLinks locationSlug={loc.slug} variant="wide" heading={`Einsätze in ${loc.name}`} />
        ) : (
          <>
            <p>
              Für {loc.name} sind hier noch keine Einsatzberichte veröffentlicht. Wir zeigen an
              dieser Stelle ausschließlich Aufträge, die tatsächlich stattgefunden haben und für die
              eine Freigabe vorliegt. Erfundene Referenzfälle würden Ihnen bei der Einschätzung Ihrer
              eigenen Situation nicht helfen.
            </p>
            <p>
              <a href="/einsatzberichte/">Was in einem Einsatzbericht stehen wird</a>
            </p>
            <Todo>
              Sobald ein Auftrag in {loc.name} abgeschlossen und vom Kunden freigegeben ist: Eintrag
              in <code>src/data/cases.ts</code> anlegen und in <code>{loc.slug}</code> unter{' '}
              <code>cases</code> verknüpfen.
            </Todo>
          </>
        )
      }
    </section>

    <Faq items={loc.faq} title={`Häufige Fragen zu ${loc.name}`} id={`faq-${loc.slug}`} />

    <NextStepPanel
      pageId={pageId}
      heading={`Einsatz in ${loc.name} anfragen`}
      text={`Schicken Sie Fotos aus jedem Raum, dazu Etage, Aufzug und die Halteposition vor dem Haus. Für ${loc.name} können wir den Aufwand dann ohne Besichtigung einschätzen.`}
    />

    <p class="updated">
      Zuletzt aktualisiert am {formatDate(loc.updated)}. Die Beschreibung fasst typische
      Rahmenbedingungen des Gebiets zusammen und ersetzt keine Prüfung Ihrer konkreten Adresse.
    </p>
  </article>

  <div class="sidebar">
    <ContactCard
      location={`standort-${loc.slug}`}
      headline={`Einsatz in ${loc.name} anfragen`}
      text="Schicken Sie Fotos aus jedem Raum, dazu Etage und Aufzug. Dann können wir den Aufwand einschätzen."
    />

    <RelevantLocations
      scope={hub}
      current={loc.slug}
      heading="Weitere Gebiete"
      limit={6}
    />

  </div>
</div>

<style>
  .draft-banner {
    background: var(--warn-tint);
    border: 2px dashed var(--warn);
    color: var(--warn);
    padding: var(--sp-3) var(--sp-4);
    margin-bottom: var(--sp-5);
    font-size: 0.92rem;
  }

  .marked li::marker {
    color: var(--accent);
  }

  .focus {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0;
    display: grid;
    gap: var(--sp-4);
  }
  @media (min-width: 34em) {
    .focus {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .focus li {
    margin: 0;
  }
  .focus a {
    height: 100%;
  }
  .focus__icon {
    display: block;
    color: var(--accent);
    margin-bottom: var(--sp-2);
  }

  .linklist {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0;
  }
  .linklist li {
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .linklist__meta {
    color: var(--ink-4);
    font-size: 0.88rem;
  }

  .sidebar {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }
</style>
