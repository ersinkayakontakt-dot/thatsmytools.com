---
/**
 * DATENSPARSAME MESSUNG
 * =====================
 *
 * Erfasst Conversion-Ereignisse und Web Vitals und sendet sie an den
 * eigenen Endpunkt `public/api/events.php`. Kein Drittanbieter, kein
 * Cookie, keine Kennung über Sitzungen hinweg.
 *
 * VORHER sammelte diese Datei Ereignisse in `window.sh24.events` und
 * sendete sie nirgendwohin – die Messung war eine Warteschlange ohne
 * Empfänger. Jetzt gibt es einen Empfänger.
 *
 * WAS DEN BROWSER VERLÄSST
 *   Ereignisname, Seitenpfad (ohne Query-String), grobe Gerätekategorie,
 *   Kanal (organic/paid/ai/referral/direct), Verweis-Host, UTM-Parameter,
 *   Einstiegsseite, dazu je nach Ereignis ein Positionsbezeichner, eine
 *   Schrittnummer, eine Anzahl oder ein Web-Vitals-Messwert.
 *
 * WAS NICHT
 *   Keine Formularinhalte, keine Namen, keine Telefonnummern, keine
 *   E-Mail-Adressen, keine Dateinamen, keine Bildinhalte, keine
 *   vollständigen URLs mit Parametern. Der Endpunkt nimmt solche Felder
 *   auch gar nicht an – er baut jeden Datensatz aus einer Allowlist neu
 *   auf, statt die eingehende Struktur zu bereinigen.
 *
 * DO NOT TRACK UND GLOBAL PRIVACY CONTROL
 * Signalisiert der Browser eines der beiden, wird NICHTS gesendet. Die
 * Ereignisse bleiben nur lokal im Speicher, damit `data-track` im Markup
 * nicht ins Leere läuft. Der Endpunkt prüft dieselben Signale erneut.
 *
 * WARUM `sendBeacon`
 * Ein normaler `fetch` beim Verlassen der Seite wird vom Browser
 * abgebrochen – gerade die interessanten Ereignisse (Formularabbruch,
 * endgültige Web Vitals) gingen dabei verloren. `sendBeacon` stellt die
 * Übertragung in eine Warteschlange, die den Seitenwechsel überlebt.
 *
 * WEB VITALS OHNE BIBLIOTHEK
 * LCP, INP und CLS liefert der Browser über `PerformanceObserver`. Die
 * verbreitete Bibliothek dafür wiegt mehrere Kilobyte und bringt für
 * diesen Zweck nichts, was hier nicht in dreißig Zeilen steht.
 *
 * RECHTLICHER HINWEIS
 * Datensparsam ist nicht automatisch einwilligungsfrei. Ob diese Messung
 * ohne Einwilligung zulässig ist, muss geprüft werden – siehe
 * CONTENT-TODO.md. Der Endpunkt bleibt bis dahin abgeschaltet
 * (`eventsEnabled` in config.local.php).
 */
---

<script is:inline>
  (function () {
    var w = window;
    var sh24 = (w.sh24 = w.sh24 || {});
    sh24.events = sh24.events || [];

    var ENDPOINT = '/api/events.php';

    /* ----------------------------------------------- Nicht-verfolgen */
    /* Beide Signale bedeuten dasselbe: keine Reichweitenmessung. */
    var doNotTrack =
      w.doNotTrack === '1' ||
      navigator.doNotTrack === '1' ||
      navigator.doNotTrack === 'yes' ||
      navigator.msDoNotTrack === '1' ||
      navigator.globalPrivacyControl === true;

    sh24.doNotTrack = doNotTrack;

    /* ------------------------------------------------ Gerätekategorie */
    /**
     * Bewusst grob und nur aus der Fensterbreite abgeleitet. Der
     * User-Agent wäre genauer, ist aber ein Fingerprint-Merkmal – und für
     * die Frage „funktioniert das Formular auf dem Telefon?" genügt die
     * Breite vollkommen.
     */
    function deviceClass() {
      var px = Math.min(screen.width || 9999, w.innerWidth || 9999);
      if (px <= 640) return 'mobile';
      if (px <= 1024) return 'tablet';
      return 'desktop';
    }

    /* ------------------------------------------------ Quelle bestimmen */
    function detectSource() {
      try {
        var stored = sessionStorage.getItem('sh24_src');
        if (stored) return JSON.parse(stored);
      } catch (e) {
        /* sessionStorage kann blockiert sein – dann eben ohne */
      }

      var params = new URLSearchParams(w.location.search);
      var ref = document.referrer || '';
      var refHost = '';
      try {
        refHost = ref ? new URL(ref).hostname.replace(/^www\./, '') : '';
      } catch (e) {
        refHost = '';
      }

      // KI-Suchsysteme getrennt erfassen. Sie erscheinen teils als
      // utm_source, teils nur als Referrer – und sie sind der Kanal, über
      // den zunehmend Anfragen kommen.
      var aiHosts = [
        'chatgpt.com',
        'chat.openai.com',
        'copilot.microsoft.com',
        'perplexity.ai',
        'gemini.google.com',
        'claude.ai',
      ];
      var channel = 'direct';
      var source = params.get('utm_source') || refHost || 'direct';

      if (params.get('utm_medium') === 'cpc' || params.get('gclid') || params.get('msclkid')) {
        channel = 'paid';
      } else if (aiHosts.indexOf(source) > -1 || aiHosts.indexOf(refHost) > -1) {
        channel = 'ai';
      } else if (
        /google|bing|duckduckgo|ecosia|yahoo/.test(source) ||
        /google|bing|duckduckgo|ecosia|yahoo/.test(refHost)
      ) {
        channel = 'organic';
      } else if (refHost && refHost !== w.location.hostname.replace(/^www\./, '')) {
        channel = 'referral';
      }

      var data = {
        channel: channel,
        source: source,
        medium: params.get('utm_medium') || '',
        campaign: params.get('utm_campaign') || '',
        referrerHost: refHost,
        landing: w.location.pathname,
      };

      try {
        sessionStorage.setItem('sh24_src', JSON.stringify(data));
      } catch (e) {
        /* ignorieren */
      }
      return data;
    }

    sh24.source = detectSource();
    sh24.device = deviceClass();

    /* --------------------------------------------------- Warteschlange */
    /**
     * Ereignisse werden gesammelt und gebündelt gesendet, nicht einzeln.
     * Das spart Anfragen und übersteht den Seitenwechsel besser.
     */
    var queue = [];
    var flushTimer = null;

    function send(batch) {
      if (doNotTrack || !batch.length) return;
      var body = JSON.stringify({ events: batch });
      try {
        if (navigator.sendBeacon) {
          var blob = new Blob([body], { type: 'application/json' });
          if (navigator.sendBeacon(ENDPOINT, blob)) return;
        }
        // Rückfallebene, wenn sendBeacon fehlt oder ablehnt.
        fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: body,
          keepalive: true,
          credentials: 'omit',
        }).catch(function () {
          /* Eine verlorene Messung ist kein Grund, die Seite zu stören. */
        });
      } catch (e) {
        /* ebenso */
      }
    }

    function flush() {
      if (flushTimer) {
        clearTimeout(flushTimer);
        flushTimer = null;
      }
      if (!queue.length) return;
      send(queue.splice(0, queue.length));
    }

    function scheduleFlush() {
      if (flushTimer) return;
      // Kurz bündeln: lang genug, um mehrere Ereignisse zusammenzufassen,
      // kurz genug, dass beim Verlassen der Seite kaum etwas offen ist.
      flushTimer = setTimeout(flush, 2000);
    }

    /* ------------------------------------------------ Ereignis erfassen */
    sh24.track = function (name, detail) {
      var evt = {
        event: name,
        detail: detail || {},
        page: w.location.pathname,
        device: sh24.device,
        source: sh24.source,
      };

      sh24.events.push(evt);

      if (!doNotTrack) {
        queue.push(evt);
        scheduleFlush();
      }

      if (w.location.hostname === 'localhost' || w.location.hostname === '127.0.0.1') {
        console.info('[sh24]', name, evt.detail, doNotTrack ? '(nicht gesendet: DNT)' : '');
      }
    };

    /* ------------------------------------- Ereignisse aus dem Markup */
    document.addEventListener(
      'click',
      function (e) {
        var el = e.target && e.target.closest ? e.target.closest('[data-track]') : null;
        if (!el) return;
        sh24.track(el.getAttribute('data-track'), {
          location: el.getAttribute('data-track-location') || '',
        });
      },
      { passive: true },
    );

    /* --------------------------------------------------- Web Vitals */
    /**
     * Drei Kennzahlen mit den Schwellen, die Google verwendet.
     * Gemessen wird nur, was der Browser ohnehin bereitstellt.
     */
    function rate(metric, value) {
      var limits = { LCP: [2500, 4000], INP: [200, 500], CLS: [0.1, 0.25] };
      var l = limits[metric];
      if (!l) return '';
      return value <= l[0] ? 'good' : value <= l[1] ? 'needs-improvement' : 'poor';
    }

    function reportVital(metric, value) {
      sh24.track('web_vital', { metric: metric, value: value, rating: rate(metric, value) });
    }

    if ('PerformanceObserver' in w) {
      var lcp = 0;
      var cls = 0;
      var inp = 0;
      var clsEntries = [];

      var observe = function (type, options, handler) {
        try {
          var po = new PerformanceObserver(handler);
          po.observe(Object.assign({ type: type, buffered: true }, options || {}));
        } catch (e) {
          /* Ältere Browser kennen einzelne Typen nicht – dann eben ohne. */
        }
      };

      // LCP: Es gilt der zuletzt gemeldete Wert, deshalb erst am Ende
      // berichten.
      observe('largest-contentful-paint', null, function (list) {
        var entries = list.getEntries();
        var last = entries[entries.length - 1];
        if (last) lcp = last.startTime;
      });

      // CLS: Summe der größten zusammenhängenden Verschiebungsfolge.
      observe('layout-shift', null, function (list) {
        list.getEntries().forEach(function (entry) {
          if (entry.hadRecentInput) return;
          var first = clsEntries[0];
          var last = clsEntries[clsEntries.length - 1];
          // Neue Folge, wenn mehr als 1 s Pause oder 5 s Gesamtdauer.
          if (
            clsEntries.length &&
            (entry.startTime - last.startTime > 1000 || entry.startTime - first.startTime > 5000)
          ) {
            clsEntries = [];
          }
          clsEntries.push(entry);
          var sum = clsEntries.reduce(function (a, e) {
            return a + e.value;
          }, 0);
          if (sum > cls) cls = sum;
        });
      });

      // INP: die schlechteste Interaktionsdauer.
      observe('event', { durationThreshold: 40 }, function (list) {
        list.getEntries().forEach(function (entry) {
          if (entry.interactionId && entry.duration > inp) inp = entry.duration;
        });
      });

      var vitalsSent = false;
      var sendVitals = function () {
        if (vitalsSent) return;
        vitalsSent = true;
        if (lcp) reportVital('LCP', Math.round(lcp));
        if (cls) reportVital('CLS', Math.round(cls * 1000) / 1000);
        if (inp) reportVital('INP', Math.round(inp));
        flush();
      };

      // `visibilitychange` ist der Zeitpunkt, der auf allen Geräten
      // zuverlässig kommt – `unload` feuert auf iOS nicht.
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') sendVitals();
      });
      w.addEventListener('pagehide', sendVitals);
    }

    /* Offene Ereignisse beim Verlassen der Seite noch mitnehmen. */
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') flush();
    });
    w.addEventListener('pagehide', flush);

    /* Seitenaufruf melden. */
    sh24.track('page_view', {});
  })();
</script>
