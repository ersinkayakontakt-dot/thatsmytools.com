---
import type { PriceFactor } from '../data/types';

/**
 * Preisfaktoren als Tabelle.
 * Absichtlich tabellarisch: extrahierbar für Antwortsysteme, gut lesbar
 * für Menschen und ehrlicher als eine erfundene Preisliste.
 */
interface Props {
  factors: PriceFactor[];
  title?: string;
  intro?: string;
  id?: string;
}
const {
  factors,
  title = 'Was den Preis bestimmt',
  intro = 'Diese Faktoren entscheiden über den Aufwand. Sie können damit jedes Angebot prüfen, auch das von anderen Betrieben.',
  id = 'preisfaktoren',
} = Astro.props;
---

<section class="pf" aria-labelledby={`${id}-head`}>
  <h2 id={`${id}-head`}>{title}</h2>
  {intro && <p class="lede">{intro}</p>}

  <div class="table-scroll table-stack">
    <table role="table">
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">Faktor</th>
          <th scope="col" role="columnheader">Einfluss</th>
          <th scope="col" role="columnheader">Warum</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {
          factors.map((f) => (
            <tr role="row">
              <th scope="row" role="rowheader">{f.name}</th>
              <td role="cell" class="pf__effect" data-label="Einfluss">{f.effect}</td>
              <td role="cell" data-label="Warum">{f.why}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="pf__hint">
    Eine belastbare Zahl entsteht erst, wenn wir die Räume gesehen haben. Deshalb nennen wir keinen
    Preis am Telefon, bevor Fotos oder eine Besichtigung vorliegen.
  </p>
</section>

<style>
  .pf {
    margin-top: var(--sp-7);
  }
  .pf__effect {
    white-space: nowrap;
    font-weight: 700;
    color: var(--accent-text);
  }
  .pf__hint {
    font-size: 0.92rem;
    color: var(--ink-3);
    max-width: 42rem;
  }
</style>
