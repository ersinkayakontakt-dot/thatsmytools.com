---
import type { ContentBlock } from '../data/types';
import { inline, headingId } from '../lib/text';

/**
 * Rendert die Inhaltsblöcke aus den Datendateien.
 * Erzeugt eine saubere Überschriftenhierarchie: die Blocküberschriften
 * liegen eine Ebene unter der H1 der Seite.
 */
interface Props {
  blocks: ContentBlock[];
  /** Überschriftenebene der Blöcke, Standard h2 */
  level?: 2 | 3;
}
const { blocks, level = 2 } = Astro.props;
const Head = `h${level}` as 'h2' | 'h3';
const SubHead = `h${level + 1}` as 'h3' | 'h4';
---

{
  blocks.map((block) => (
    <section class="block">
      <Head id={headingId(block.h)}>
        {block.h}
      </Head>

      {block.p?.map((para) => <p set:html={inline(para)} />)}

      {block.list && (
        <ul class="block__list">
          {block.list.map((item) => (
            <li set:html={inline(item)} />
          ))}
        </ul>
      )}

      {block.steps && (
        <ol class="steps">
          {block.steps.map((step) => (
            <li>
              <div class="steps__content">
                <SubHead class="steps__title">{step.title}</SubHead>
                <p set:html={inline(step.text)} />
              </div>
            </li>
          ))}
        </ol>
      )}

      {block.table && (
        <div class="table-scroll table-stack">
          {/* Rollen ausdrücklich: Die gestapelte Handy-Darstellung (global.css,
              .table-stack) setzt display:block, und manche Screenreader
              verlieren dann die Tabellensemantik. */}
          <table role="table">
            {block.table.caption && <caption>{block.table.caption}</caption>}
            <thead role="rowgroup">
              <tr role="row">
                {block.table.head.map((h) => (
                  <th scope="col" role="columnheader">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody role="rowgroup">
              {block.table.rows.map((row) => (
                <tr role="row">
                  {row.map((cell, i) =>
                    i === 0 ? (
                      <th scope="row" role="rowheader" set:html={inline(cell)} />
                    ) : (
                      <td role="cell" data-label={block.table!.head[i] ?? ''} set:html={inline(cell)} />
                    ),
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {block.note && (
        <aside class={`note${block.note.tone === 'caution' ? ' note--caution' : ''}`}>
          <p class="note__title">{block.note.title}</p>
          <p set:html={inline(block.note.text)} />
        </aside>
      )}
    </section>
  ))
}

<style>
  .block {
    margin-bottom: var(--sp-6);
  }
  .block:last-child {
    margin-bottom: 0;
  }
  /* Schrittüberschriften nutzen die Textschrift, nicht die Serifenschrift */
  .block :global(.steps__title) {
    font-family: var(--font-body);
    font-size: 1rem;
    margin: 0 0 var(--sp-1);
  }
  .block__list li::marker {
    color: var(--accent);
  }
  .block :global(.steps__title) {
    letter-spacing: -0.012em;
  }
  .steps__content {
    min-width: 0;
  }
</style>
