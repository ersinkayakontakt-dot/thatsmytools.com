---
import Icon from './Icon.astro';
import { phone, whatsapp, primaryCta } from '../lib/contact';

/**
 * Mobile Aktionsleiste.
 * Bewusst dezent: eine Zeile, drei Wege, kein Pop-up, kein Overlay,
 * keine künstliche Dringlichkeit. Nur auf kleinen Bildschirmen sichtbar,
 * body hat unten entsprechenden Innenabstand (siehe global.css).
 */
---

<div class="stickybar no-print">
  {
    phone.available && (
      <a class="stickybar__item" href={phone.href} data-track="phone_click" data-track-location="stickybar">
        <Icon name="phone" size={20} />
        <span>Anrufen</span>
      </a>
    )
  }
  {
    whatsapp.available && (
      <a
        class="stickybar__item"
        href={whatsapp.href}
        target="_blank"
        rel="noopener"
        data-track="whatsapp_click"
        data-track-location="stickybar"
      >
        <Icon name="whatsapp" size={20} />
        <span>WhatsApp</span>
      </a>
    )
  }
  <a class="stickybar__item stickybar__item--primary" href={primaryCta.href}>
    <Icon name="camera" size={20} />
    <span>Fotos senden</span>
  </a>
</div>

<style>
  .stickybar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: flex;
    background: var(--white);
    border-top: 1px solid var(--line-strong);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .stickybar__item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    min-height: var(--stickybar-h);
    padding: 0.4rem 0.25rem;
    color: var(--brand);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    border-right: 1px solid var(--paper-3);
  }
  .stickybar__item:last-child {
    border-right: 0;
  }
  .stickybar__item--primary {
    background: var(--accent);
    color: var(--white);
  }
  .stickybar__item--primary:hover {
    background: var(--accent-2);
    color: var(--white);
  }

  @media (min-width: 48em) {
    .stickybar {
      display: none;
    }
  }
</style>
