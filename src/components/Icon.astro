---
/**
 * Inline-SVG-Icons. Bewusst als Strichzeichnung gehalten, passend zum
 * Grundriss-Motiv. Keine Icon-Bibliothek, kein zusätzlicher Request.
 * Dekorative Icons sind aria-hidden – der Text daneben trägt die Bedeutung.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  /** Nur setzen, wenn das Icon allein steht und Bedeutung trägt. */
  label?: string;
}
const { name, size = 24, class: cls = '', label } = Astro.props;

const paths: Record<string, string> = {
  boxes:
    '<path d="M3 8.5 12 4l9 4.5M3 8.5v7L12 20l9-4.5v-7M3 8.5 12 13l9-4.5M12 13v7"/>',
  home: '<path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/>',
  key: '<circle cx="8" cy="8" r="4"/><path d="M11 11l9 9M17 17l2-2M14 14l2-2"/>',
  heart: '<path d="M12 20s-7-4.5-7-9.5A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.5C19 15.5 12 20 12 20z"/>',
  shield: '<path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/>',
  truck:
    '<path d="M3 6h11v10H3zM14 9h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>',
  people:
    '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0M17 11a3 3 0 1 0-2-5.2M21 20a5.5 5.5 0 0 0-3.5-5"/>',
  stairs: '<path d="M3 20h5v-4h5v-4h5V8h3"/><path d="M3 20V4"/>',
  building:
    '<path d="M4 21V5l8-2v18M12 21h8V9l-8-3"/><path d="M7 8h2M7 12h2M7 16h2M15 11h2M15 15h2"/>',
  tools: '<path d="M14 6a4 4 0 0 1 5.5 5L21 12l-9 9-3-3 9-9zM8 4l3 3-3 3-4-4z"/>',
  phone:
    '<path d="M6 3h3l2 5-2.5 1.5a12 12 0 0 0 6 6L16 13l5 2v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4 5.2 2 2 0 0 1 6 3z"/>',
  whatsapp:
    '<path d="M20 12a8 8 0 0 1-11.9 7L4 20l1.1-3.9A8 8 0 1 1 20 12z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5.6 0 1-.5 1-1l-1.5-.8-1 .8a5 5 0 0 1-2.5-2.5l.8-1L10.5 9c-.5 0-1.5.1-1.5.5z"/>',
  mail: '<path d="M3 6h18v12H3z"/><path d="m3 7 9 6 9-6"/>',
  check: '<path d="m4 12 5 5L20 6"/>',
  arrow: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  clock: '<circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/>',
  doc: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/>',
  camera:
    '<path d="M3 8h4l1.5-2h7L17 8h4v11H3z"/><circle cx="12" cy="13" r="3.5"/>',
  pin: '<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
};

const body = paths[name] ?? paths.check;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  focusable="false"
  set:html={label ? `<title>${label}</title>${body}` : body}
/>
