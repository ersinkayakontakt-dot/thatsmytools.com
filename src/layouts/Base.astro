---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import Analytics from '../components/Analytics.astro';
import { site, absoluteUrl } from '../config/site';
import { seoPageByUrl, ogImageFor } from '../data/seo-pages';

/**
 * Basis-Layout.
 * Enthält Kopfdaten, strukturierte Daten, Skip-Link, Kopf- und Fußbereich
 * sowie die mobile Aktionsleiste.
 *
 * Alle Kerninhalte werden statisch gerendert. Es gibt keinen wichtigen
 * Inhalt, der erst durch JavaScript im Browser entsteht.
 */
interface Props {
  title: string;
  description: string;
  /** Pfad ohne Domain, z. B. "/leistungen/entruempelung-berlin/" */
  path: string;
  /** false -> noindex,follow (Entwürfe, Bestätigungsseiten, 404) */
  index?: boolean;
  /** Fertiger JSON-LD-Graph */
  schema?: unknown;
  /**
   * Abweichendes Vorschaubild.
   * Ohne Angabe wird es aus der SEO-Seitenkarte bestimmt: Seiten mit
   * `ownOgImage: true` bekommen ihr eigenes, alle anderen das allgemeine.
   */
  ogImage?: string;
  /** Für Artikel: Veröffentlichungs- und Änderungsdatum */
  published?: string;
  modified?: string;
  /** Wird ohne StickyBar gerendert, z. B. auf dem Formular */
  hideStickyBar?: boolean;
}

const {
  title,
  description,
  path,
  index = true,
  schema,
  ogImage,
  published,
  modified,
  hideStickyBar = false,
} = Astro.props;

const canonical = absoluteUrl(path);

/**
 * Vorschaubild aus der Seitenkarte auflösen. Das geschieht hier zentral,
 * damit nicht zwanzig Seiten dieselbe Zeile tragen müssen – und damit eine
 * neue Seite mit `ownOgImage: true` das Bild automatisch bekommt.
 */
const seoEntry = seoPageByUrl(path);
const ogImageUrl = absoluteUrl(ogImage ?? (seoEntry ? ogImageFor(seoEntry) : '/og-default.png'));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta
      name="robots"
      content={index ? 'index, follow, max-image-preview:large, max-snippet:-1' : 'noindex, follow'}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} – ${site.tagline}`} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#14171a" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="geo.region" content="DE-BE" />
    <meta name="geo.placename" content="Berlin" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    {!hideStickyBar && <StickyBar />}
  </body>
</html>
