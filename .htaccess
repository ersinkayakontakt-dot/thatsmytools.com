# =====================================================================
# schnellhelfer24.de – Serverkonfiguration (Apache)
# =====================================================================
# Diese Datei wird beim Build unverändert nach dist/ kopiert und gehört
# in das Webverzeichnis (bei Hostinger: public_html).
#
# Bei nginx muss dasselbe in der Serverkonfiguration abgebildet werden,
# siehe docs/ARCHITEKTUR.md.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Zeichensatz und Standarddokument
# ---------------------------------------------------------------------
AddDefaultCharset UTF-8
DirectoryIndex index.html index.php

# Kein Verzeichnislisting
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # -------------------------------------------------------------------
  # 2. Eine kanonische Adresse
  # -------------------------------------------------------------------
  # HTTPS erzwingen
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://schnellhelfer24.de/$1 [R=301,L]

  # www entfernen. Wer lieber www verwendet, dreht diese Regel um UND
  # ändert `site.url` in src/config/site.ts. Beides muss zusammenpassen,
  # sonst zeigen die Canonicals auf die falsche Variante.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # -------------------------------------------------------------------
  # 3. Weiterleitungen alter Adressen
  # -------------------------------------------------------------------
  # WICHTIG vor dem Livegang: Die Adressen der bisherigen Website hier
  # eintragen. Vorgehen:
  #   1. Alte URLs sammeln (Google Search Console, Bing Webmaster Tools,
  #      alte Sitemap, Serverlogs, Screaming Frog).
  #   2. Jede alte URL auf die thematisch passende neue Seite leiten,
  #      NICHT pauschal auf die Startseite. Pauschale Weiterleitungen
  #      auf "/" wertet Google wie einen 404.
  #   3. Nach dem Umstellen mit einem Crawler prüfen, dass keine Kette
  #      und keine Schleife entsteht.
  #
  # Beispiele (auskommentiert, an die echten alten Adressen anpassen):
  #
  # Redirect 301 /entruempelung.html      /leistungen/entruempelung-berlin/
  # Redirect 301 /haushaltsaufloesung     /leistungen/haushaltsaufloesung-berlin/
  # Redirect 301 /umzuege                 /leistungen/umzug-berlin/
  # Redirect 301 /kontakt.php             /kontakt/
  # Redirect 301 /leistungen.html         /leistungen/
  # Redirect 301 /preise                  /kosten/

  # Häufige Altlasten aus CMS-Installationen abfangen
  RewriteRule ^index\.(php|html?)$ / [R=301,L]

  # -------------------------------------------------------------------
  # 4. Einheitliche Schreibweise mit Schrägstrich am Ende
  # -------------------------------------------------------------------
  # Die Website wird mit trailingSlash: 'always' gebaut. Ohne diese
  # Regel wären /kontakt und /kontakt/ zwei Adressen mit gleichem Inhalt.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------------
# 5. Fehlerseiten
# ---------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# 6. Sicherheitskopfzeilen
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"

  # Content Security Policy.
  # Die Website lädt keine externen Skripte, Schriften oder Bilder.
  # 'unsafe-inline' für Skripte ist nötig, weil die wenigen kleinen
  # Skripte bewusst inline liegen (keine zusätzlichen Anfragen).
  #
  # connect-src 'self' ist ausdrücklich gesetzt, obwohl default-src das
  # ohnehin abdecken würde: Der Messbeacon (navigator.sendBeacon auf
  # /api/events.php) soll erkennbar erlaubt sein und nicht stillschweigend
  # von einer allgemeinen Regel getragen werden. Wer default-src später
  # verschärft, sieht dann sofort, was davon abhängt.
  #
  # Wenn je ein externer Analytics-Dienst dazukommt, gehört seine Domain
  # in connect-src – und dann ist er zustimmungspflichtig.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  # -------------------------------------------------------------------
  # HSTS – Strict-Transport-Security
  # -------------------------------------------------------------------
  # NOCH NICHT AKTIV. Bewusst.
  #
  # HSTS ist die einzige Kopfzeile hier, die sich nicht einfach
  # zurücknehmen lässt: Browser merken sich die Anweisung für die gesamte
  # `max-age`. Wer sie zu früh oder zu weit setzt, sperrt Besucherinnen
  # und Besucher aus, bis die Frist abläuft – ein Rückgängigmachen auf dem
  # Server hilft dann nicht mehr.
  #
  # STAND DER PRÜFUNG (06.08.2026, gegen die Live-Domain gemessen):
  #
  #   https://schnellhelfer24.de/       HTTP 200
  #   https://www.schnellhelfer24.de/   HTTP 301 auf die Hauptdomain
  #   http://schnellhelfer24.de/        HTTP 301 auf HTTPS
  #   Strict-Transport-Security         derzeit NICHT gesetzt
  #   Server                            hcdn (Hostinger-CDN)
  #
  #   Geprüfte Subdomains ohne HTTPS-Antwort: mail, webmail, ftp, cpanel,
  #   staging, test, dev, shop, blog, api.
  #   ABER: `autodiscover.schnellhelfer24.de` hat einen DNS-Eintrag
  #   (Mail-Client-Konfiguration). Genau solche Dienste sind der Grund,
  #   `includeSubDomains` nicht im ersten Schritt zu setzen.
  #
  # EMPFOHLENES VORGEHEN IN DREI STUFEN
  #
  #   Stufe 1 – fünf Minuten, ohne Subdomains. Eine Woche beobachten.
  #     Header always set Strict-Transport-Security "max-age=300"
  #
  #   Stufe 2 – ein Jahr, weiterhin ohne Subdomains.
  #     Header always set Strict-Transport-Security "max-age=31536000"
  #
  #   Stufe 3 – nur wenn zuvor bestätigt wurde, dass JEDE Subdomain
  #     dauerhaft HTTPS mit gültigem Zertifikat liefert. Vorher prüfen,
  #     ob die Mail-Einrichtung (autodiscover) darunter leidet.
  #     Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  #
  # PRELOAD-LISTE: nicht empfohlen. Die Aufnahme ist praktisch dauerhaft
  # und die Entfernung dauert Monate. Für einen lokalen Handwerksbetrieb
  # steht der Nutzen in keinem Verhältnis zum Risiko.
  #
  # RÜCKNAHME, solange nur Stufe 1 aktiv war: Zeile entfernen und
  # höchstens fünf Minuten warten. Ab Stufe 2 ist eine Rücknahme faktisch
  # nicht mehr möglich.
  #
  # Prüfen nach dem Aktivieren:
  #   curl -sI https://schnellhelfer24.de/ | grep -i strict-transport
</IfModule>

# ---------------------------------------------------------------------
# 7. Komprimierung
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# 8. Zwischenspeicherung
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Dateien mit Prüfsumme im Namen dürfen lange zwischengespeichert werden
  <FilesMatch "\.(css|js)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"

  # HTML immer frisch prüfen, damit Änderungen sofort sichtbar sind
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

# ---------------------------------------------------------------------
# 9. Richtige Inhaltstypen
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------------
# 10. Versteckte Dateien sperren
# ---------------------------------------------------------------------
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
