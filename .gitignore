# Laufzeitdaten des PHP-Endpunkts (dürfen niemals ins Repo).
# Hochgeladene Wohnungsfotos und eingegangene Anfragen bleiben lokal.
# Die Schutzdateien des Verzeichnisses werden dagegen versioniert.
public/api/_storage/*
!public/api/_storage/.htaccess
!public/api/_storage/.gitkeep
public/api/config.local.php

# Such- und Betriebsdaten (Search Console, Bing, Serverlogs).
# Betriebsdaten gehoeren nicht ins Repository.
#
# ACHTUNG, am 24.09.2026 korrigiert: Das Muster stand hier ohne fuehrenden
# Schraegstrich als "data/" und trifft in dieser Form JEDE Ebene - also auch
# src/data/. Dadurch waren src/data/seo-pages.ts, src/data/images.ts und
# src/data/serviceAreas.ts nie im Repository. Ein frischer Klon liess sich
# damit nicht bauen: npm run seo:metadata bricht ohne seo-pages.ts ab.
# Der fuehrende Schraegstrich bindet das Muster an das Wurzelverzeichnis.
/data/
