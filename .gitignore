# Laufzeitdaten des PHP-Endpunkts (dürfen niemals ins Repo).
# Hochgeladene Wohnungsfotos und eingegangene Anfragen bleiben lokal.
# Die Schutzdateien des Verzeichnisses werden dagegen versioniert.
public/api/_storage/*
!public/api/_storage/.htaccess
!public/api/_storage/.gitkeep
public/api/config.local.php

# Such- und Betriebsdaten (Search Console, Bing, Serverlogs).
# Nur das Datenverzeichnis im Projektstamm ignorieren. `src/data/` enthält
# dagegen versionierte Inhalts- und SEO-Daten und darf nie erfasst werden.
/data/
