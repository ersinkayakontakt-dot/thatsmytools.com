# Schutz des API-Verzeichnisses (Apache)
#
# Ziel: Nur anfrage.php ist von außen erreichbar. Alles andere,
# insbesondere die Ablage mit den hochgeladenen Fotos und der lokalen
# Konfiguration, ist nicht abrufbar.
#
# Bei nginx muss dasselbe in der Serverkonfiguration abgebildet werden,
# siehe docs/ARCHITEKTUR.md.

# Kein Verzeichnislisting
Options -Indexes

# Konfiguration und Ablage sperren
<FilesMatch "^(config\.local\.php|config\.example\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Endpunkt nicht indexieren lassen
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Uploadgrößen passend zum Formular (12 Bilder à 8 MB plus Reserve)
<IfModule mod_php.c>
  php_value upload_max_filesize 8M
  php_value post_max_size 64M
  php_value max_file_uploads 14
</IfModule>
